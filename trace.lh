# Compares the hand-written skills (src/chara/yui.lh) with the generated ones
# (src/chara/yui/skills) frame by frame: image, offset, position and boxes.
#
#   lovec trace.lh
module^vp.trace

import^love.event
import^love.math

require^"src/fighter.lh"
require^"src/chara/yui.lh"
require^"src/chara/yui/skills.lh"

let^Fighter = vp.fighter.Fighter
let^yui = vp.chara.yui
let^FRAMES = 400

# Everything a frame shows, as one line. Slot 19 is FM2K's parked box
# (y = 9899), which the hand-written skills leave out.
let^snapshot = p^me:Fighter-> string^{
    var^s = $"i{me.image} ({me.ix},{me.iy}) x{me.x}"
    for^slot from^0 to^18 {
        let^b = me.hurts[slot]
        if^b fits^vp.fighter.Box { s ..= $" d{slot}:{b.x},{b.y},{b.w},{b.h}" }
        let^h = me.hits[slot]
        if^h fits^vp.fighter.Box { s ..= $" a{slot}:{h.x},{h.y},{h.w},{h.h},{h.power}" }
    }
    return^s
}

let^handSkill = p^name:string^, me:Fighter{
    if^name = "stand" { me.play(name, yui.stand(me))
    elseif^name = "walkForward": me.play(name, yui.walkForward(me))
    elseif^name = "walkBack": me.play(name, yui.walkBack(me))
    elseif^name = "crouchDown": me.play(name, yui.crouchDown(me))
    elseif^name = "crouch": me.play(name, yui.crouch(me))
    elseif^name = "standUp": me.play(name, yui.standUp(me))
    elseif^name = "lightKick": me.play(name, yui.lightKick(me))
    elseif^name = "crouchJab": me.play(name, yui.crouchJab(me))
    }
}

let^compare = p^name:string^, number:number^{
    let^a = Fighter.new(yui.dir, 0, 880)
    let^b = Fighter.new(yui.dir, 0, 880)
    vp.skills.yui.index.install(b)
    love.math.setRandomSeed(7)
    handSkill(name, a)
    var^left : t^{string^[]} = {}
    for^f from^0 to^FRAMES - 1 {
        if^a.finished() { break^ }
        a.step()
        left.push^(snapshot(a))
    }
    love.math.setRandomSeed(7)
    b.begin(number)
    var^diffs = 0
    for^f from^0 to^left.length^ - 1 {
        if^b.finished() {
            print($"  {name}: generated ended at frame {f}, hand-written runs to {left.length^}")
            diffs += 1
            break^
        }
        b.step()
        let^got = snapshot(b)
        if^got != left[f] {
            if^diffs < 3 { print($"  {name} frame {f}\n    hand: {left[f]}\n    gen:  {got}") }
            diffs += 1
        }
    }
    let^verdict = if^diffs = 0: "same" el^: $"{diffs} frames differ";
    print($"{name} (#{number}): {left.length^} frames, {verdict}")
}

public^let^load = p^{
    compare("stand", 1)
    compare("walkForward", 2)
    compare("walkBack", 3)
    compare("crouchDown", 11)
    compare("crouch", 12)
    compare("standUp", 13)
    compare("lightKick", 213)
    compare("crouchJab", 214)
    love.event.quit()
}
