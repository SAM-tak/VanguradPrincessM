# The character select screen, as FM2K's engine runs it (TechnicalDocuments/
# 0015). The demo "キャラセレ" draws the screen from system variables; the
# engine moves the cursors on the grid, puts the character under a cursor up
# as its portrait object (the character's #25, which also picks the support
# with left / right) and confirms on a button, whose number is the colour.
#
# Story shows only 1P. In VS each player controls their own selection.
module^vp.select

import^love.graphics

require^"fighter.lh"
require^"sprite.lh"
require^"script.lh"
require^"stage.lh"
require^"hud.lh"
require^"round.lh"

let^Fighter = vp.fighter.Fighter

# The system file's built-in skills and its selection screen settings.
let^CURSOR_1P = 84
let^CURSOR_2P = 85
let^CONFIRMED_1P = 86
let^CONFIRMED_2P = 87
let^GRID_X = 320              # charStartPosX / Y, distanceBetweenCharsY, rows
let^GRID_Y = 50
let^GRID_STEP = 40
let^ROWS = 10
let^PORTRAIT_1P_X = 87        # p1CursorPosX / Y: where the portrait object stands
let^PORTRAIT_2P_X = 553
let^PORTRAIT_Y = 55
let^PORTRAIT = 25             # a character's built-in "select screen face"
let^AFTER_BOTH = 100          # frames from both confirmed to the battle

# The characters on the grid, top to bottom (the system file's list, under
# the port's names: tools/fm2k_convert/names.py).
public^let^CHARACTERS = { "ゆい", "はるか", "リリス", "ルナ", "くるみ", "サキ", "かえで", "カテジナ", "えり", "あやね" }

public^let^Side = def^{
    self^{
        row = 0,
        cursor : Fighter|nil^= nil^,
        portrait : Fighter|nil^= nil^,
        confirmed = false^,
        colour = 0,
    },
}

public^let^Select = def^{
    self^{
        system : vp.script.Script|nil^= nil^,
        systemDir = "",
        demo : vp.stage.Stage|nil^= nil^,
        sides : t^{Side[]} = {},
        wait = 0,                   # frames since both confirmed
        done = false^,
        story = false^,
    },
}

# Scripts of the characters, loaded once: the whole one (script.lton, for a
# match) and the portrait's (portrait.lton: only what the select screen's #25
# runs, so the screen opens without reading every whole script;
# TechnicalDocuments/0023).
var^scripts : t^{[string^]:vp.script.Script|nil^} = {}

let^loadScript = p^name:string^, file:string^-> vp.script.Script{
    let^key = $"{name}/{file}"
    let^known = scripts[key]
    if^known != nil^ { return^known }
    let^sc = vp.script.load($"assets/characters/{name}/{file}") ?? vp.script.Script.new()
    scripts[key] := sc
    return^sc
}

public^let^scriptOf = p^name:string^-> vp.script.Script{
    return^loadScript(name, "script.lton")
}

let^portraitOf = p^name:string^-> vp.script.Script{
    return^loadScript(name, "portrait.lton")
}

let^systemRun = p^s:Select, n:number^, x:number^, y:number^-> Fighter{
    let^l = Fighter.new(s.systemDir, x, y)
    let^sc = s.system
    if^sc != nil^ { vp.script.install(l, sc) }
    l.system := true^
    l.depth := 101
    l.begin(n)
    l.ground := 1000000
    return^l
}

let^slotY = f^row:number^-> number^{
    return^GRID_Y + GRID_STEP * row
}

# The character under side k's cursor as its portrait object.
let^showPortrait = p^s:Select, k:number^{
    let^maybe = s.sides[k]
    if^maybe is^nil^{ return^}
    let^side : Side = maybe
    let^name = CHARACTERS[side.row] ?? "ゆい"
    let^p = Fighter.new($"assets/characters/{name}", if^k = 0: PORTRAIT_1P_X el^: PORTRAIT_2P_X;, PORTRAIT_Y)
    vp.script.install(p, portraitOf(name))
    p.ground := 1000000
    p.onScreen := true^
    p.facing := if^k = 0: 1 el^: -1;
    p.depth := 100
    p.begin(PORTRAIT)
    side.portrait := p
    side.cursor := systemRun(s, if^k = 0: CURSOR_1P el^: CURSOR_2P;, GRID_X, slotY(side.row))
}

public^let^load = p^systemDir:string^, story:bool^-> Select{
    let^s = Select.new()
    s.systemDir := systemDir
    s.story := story
    s.system := vp.script.load($"{systemDir}/script.lton")
    s.demo := vp.stage.load("assets/demos/キャラセレ")
    let^demo = s.demo
    if^demo != nil^ {
        for^layer in^demo.layers {
            # Confirmation belongs to the mode menu. The current converted
            # opening uses cue 3; also mute the original coin cue in slot 2.
            layer.mutedSounds[2] := true^
            layer.mutedSounds[3] := true^
        }
    }
    s.sides := { Side.new(), Side.new() }
    vp.fighter.clearSystemVars()
    # VS mode: both sides are up from the start (the 2P cursor #85 moves
    # system variable 139 off 500, the select screen's "1P only" mark, and
    # the screen lays itself out for two: 2P's support, no move list).
    showPortrait(s, 0)
    if^!story { showPortrait(s, 1) }
    return^s
}

# All human choices are confirmed (one in story, two in VS).
public^let^bothChosen = f^s:Select-> bool^{
    let^first = s.sides[0]
    let^last = s.sides[if^s.story: 0 el^: 1;]
    return^first != nil^ and^first.confirmed and^last != nil^ and^last.confirmed
}

# The first button of a pressed set (A = 0 ... F = 5): the colour.
let^firstButton = f^pressed:number^-> number^{
    var^rest = pressed
    for^k from^0 to^5 {
        if^rest % 2 = 1 { return^k }
        rest := (rest / 2).floor()
    }
    return^0
}

# Which side's system variable 141 (set when a side confirms) the portraits
# see: each sees its own side's state (FM2K has one for both players).
let^confirmFlag = p^side:Side, me:Fighter{
    vp.fighter.setv(me, 141, if^side.confirmed: 1 el^: 0;)
}

# One frame. dir: FM2K's direction code (5 = none, 8 up, 2 down, 4 / 6 left
# / right), pressed: the buttons pressed this frame (A = 1 ... F = 32).
public^let^step = p^s:Select, up:bool^, down:bool^, dir:number^, pressed:number^, up2:bool^, down2:bool^, dir2:number^, pressed2:number^{
    let^st = s.demo
    if^st != nil^ { vp.stage.step(st) }

    for^k from^0 to^(if^s.story: 0 el^: 1;) {
        let^u = if^k = 0: up el^: up2;
        let^d = if^k = 0: down el^: down2;
        let^b = if^k = 0: pressed el^: pressed2;
        let^maybe = s.sides[k]
        if^maybe != nil^ and^!maybe.confirmed {
            let^side : Side = maybe
            if^u or^d {
                side.row := (side.row + (if^d: 1 el^: -1;) + ROWS) % ROWS
                showPortrait(s, k)
            elseif^b != 0:
                side.confirmed := true^
                side.colour := firstButton(b)
                side.cursor := systemRun(s, if^k = 0: CONFIRMED_1P el^: CONFIRMED_2P;, GRID_X, slotY(side.row))
            }
        }
    }

    for^i, sd in^s.sides {
        let^p = sd.portrait
        if^p != nil^ {
            confirmFlag(sd, p)
            vp.fighter.record(p, if^sd.confirmed: 5 el^i = 0: dir el^: dir2;, 0)
            p.step()
            vp.fighter.stepObjects(p)
        }
        let^c = sd.cursor
        if^c != nil^ {
            c.step()
            vp.fighter.stepObjects(c)
        }
    }

    if^bothChosen(s) {
        s.wait += 1
        if^s.wait > AFTER_BOTH { s.done := true^ }
    }
}

# The choices once done.
public^let^chosen = p^s:Select, k:number^-> (string^, number^){
    let^side = s.sides[k]
    if^side is^nil^{ return^"ゆい", 0 }
    return^CHARACTERS[side.row] ?? "ゆい", side.colour
}

# Draws the screen in view coordinates, by depth as measured in the original
# (TechnicalDocuments/0015): the demo's layers before ｼｽﾃﾑｲﾒｰｼﾞ位置 (12), the
# portraits (80) and their big faces (79), the layers from the marker on
# (100: the grid's icons), the cursors (101) and the support arrows (127).
public^let^draw = p^s:Select{
    let^st = s.demo
    if^st is^nil^{ return^}
    vp.fighter.setView(0, 0)
    vp.stage.draw(st, 0, 0, 0, st.players)
    var^list : t^{vp.round.Item[]} = {}
    let^add = p^f:Fighter, system:bool^{
        let^i = vp.round.Item.new()
        i.depth := f.depth
        i.f := f
        i.system := system
        list.push^(i)
    }
    for^sd in^s.sides {
        let^p = sd.portrait
        if^p != nil^ {
            add(p, false^)
            for^o in^p.objects { add(o, false^) }
        }
        let^c = sd.cursor
        if^c != nil^ {
            add(c, true^)
            for^o in^c.objects { add(o, true^) }
        }
    }
    # Objects the screen's layers spawn (the curtain the converter's patch
    # moved to depth 127, TechnicalDocuments/0019): after the others, so over
    # those of the same depth.
    for^l in^st.layers {
        for^o in^l.objects { add(o, true^) }
    }
    vp.round.byDepth(list)
    for^i in^list {
        if^i.depth <= 100 { vp.round.drawItem(i) }
    }
    vp.stage.draw(st, 0, 0, st.players, st.layers.length^)
    for^i in^list {
        if^i.depth > 100 { vp.round.drawItem(i) }
    }
}
