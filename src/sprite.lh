# Sprites converted by tools/fm2k_convert: 8-bit index PNGs drawn through a
# palette row, so one set of images serves every colour variant.
module^vp.sprite

import^love.graphics

require^"arena.lh"
require^"resource.lh"

# Indexed images look their colour up in a palette row; images that carried
# their own palette are already RGBA. Either way FM2K's COLOR tint is added:
# each channel + offset / 32 (-32..32).
let^spriteCode = "extern Image palette;
extern number row;
extern number indexed;
extern vec3 tint;
vec4 effect(vec4 color, Image tex, vec2 tc, vec2 sc) {
    vec4 c = Texel(tex, tc);
    if (indexed > 0.5) {
        float index = floor(c.r * 255.0 + 0.5);
        c = Texel(palette, vec2((index + 0.5) / 256.0, (row + 0.5) / 8.0));
    }
    c.rgb = clamp(c.rgb + tint, 0.0, 1.0);
    return c * color;
}
"

var^shader : love.graphics.Shader|nil^= nil^

# FM2K's COLOR blends: 0 normal, 1 half transparent, 2 additive, 3 subtractive,
# 4 custom alpha. `alpha` is the opacity for 1 and 4.
public^let^setBlend = p^mode:number^, alpha:number^{
    if^mode = 2 {
        love.graphics.setBlendMode(love.graphics.BlendMode.add)
    elseif^mode = 3:
        love.graphics.setBlendMode(love.graphics.BlendMode.subtract)
    else^:
        love.graphics.setBlendMode(love.graphics.BlendMode.alpha)
    }
    love.graphics.setColor(1, 1, 1, if^mode = 1 or^mode = 4: alpha el^: 1;)
}

public^let^resetBlend = p^{
    love.graphics.setBlendMode(love.graphics.BlendMode.alpha)
    love.graphics.setColor(1, 1, 1, 1)
}

# Where an images.lton / sounds.lton entry's file is: `file` in the folder
# itself, `shared` in assets/shared (what share_assets.py moved there because
# two or more characters hold the same bytes; TechnicalDocuments/0020).
public^let^SHARED_DIR = "assets/shared"

public^let^assetPath = f^dir:string^, e:any^-> string^|nil^{
    if^e fits^t^{ shared : string^ } { return^$"{SHARED_DIR}/{e.shared}" }
    if^e fits^t^{ file : string^ } { return^$"{dir}/{e.file}" }
    return^nil^
}

# A converted folder's listing (images.lton, sounds.lton): one entry per
# FM2K number, at that position; nil^ for an unused number. Read once per
# file; nil^ when the folder has none.
var^listings : t^{[string^]:t^{}|nil^} = {}
var^listingsTried : t^{[string^]:bool^|nil^} = {}

public^let^listing = p^file:string^-> t^{}|nil^{
    if^listingsTried[file] is^nil^{
        listingsTried[file] := true^
        let^list = vp.resource.data(file)
        if^list fits^t^{} { listings[file] := list }
    }
    return^listings[file]
}

# One character's (or stage's) converted images.
public^let^Sheet = def^{
    self^{
        dir = "",
        palette : love.graphics.Texture|nil^= nil^,
        paletteTried = false^,     # stages have no palettes.png
        images : t^{[number^]:love.graphics.Texture|nil^} = {},
        missing : t^{[number^]:bool^|nil^} = {},    # asked for, not there (logged once)
        gen = -1,                   # the scene (vp.arena) its images were loaded in
    },
    override^new = f^dir:string^{ self^{ dir = dir } },

    listing = p^self^-> t^{}|nil^{
        return^listing($"{self^.dir}/images.lton")
    },

    # A new scene (vp.arena) disposed the last one's textures: start over.
    fresh = p^self^{
        if^self^.gen = vp.arena.generation() { return^}
        self^.gen := vp.arena.generation()
        self^.images := {}
        self^.palette := nil^
        self^.paletteTried := false^
    },

    # Whether image i is palette-indexed (images.lton says "indexed" or "rgba").
    isIndexed = p^self^, i:number^-> bool^{
        let^l = self^.listing()
        if^l is^nil^{ return^false^ }
        let^e : any^= l[i]
        return^e fits^t^{ format : string^ } and^e.format = "indexed"
    },

    # Texture for an FM2K image number, loaded on first use.
    image = p^self^, i:number^-> love.graphics.Texture|nil^{
        self^.fresh()
        let^cached = self^.images[i]
        if^cached fits^love.graphics.Texture { return^cached }
        if^self^.missing[i] != nil^ { return^nil^ }
        # No entry: an unused number, or one share_assets.py dropped as another
        # character's image (TechnicalDocuments/0020). A folder without a
        # listing keeps the old layout.
        let^l = self^.listing()
        let^path = if^l is^nil^: $"{self^.dir}/images/{i:%04d}.png" el^: assetPath(self^.dir, l[i]);
        let^loaded = if^path != nil^: vp.arena.texture(path) el^: nil^;
        if^loaded fits^love.graphics.Texture {
            self^.images[i] := loaded
        else^:
            self^.missing[i] := true^
            # past the listing's end is no image at all (FM2K's 8191 = 0x1FFF,
            # an I block that shows nothing): not worth a word
            if^i >= 0 and^(l is^nil^ or^i < l.length^) { print($"画像がない: {self^.dir} #{i}") }
        }
        return^loaded
    },

    # Size of image i (0, 0 when it cannot be loaded).
    size = p^self^, i:number^-> (number^, number^){
        let^tex = self^.image(i)
        if^tex fits^love.graphics.Texture { return^tex.getDimensions() }
        return^0, 0
    },

    # Sets the sprite shader for image i: palette row `row` when the image is
    # indexed, tint (tr, tg, tb).
    useShader = p^self^, i:number^, row:number^, tr:number^, tg:number^, tb:number^{
        if^shader is^nil^{
            shader := love.graphics.newShader(spriteCode) catch^nil^
        }
        self^.fresh()
        if^!self^.paletteTried {
            self^.paletteTried := true^
            self^.palette := vp.arena.texture($"{self^.dir}/palettes.png")
        }
        let^s = shader
        let^pal = self^.palette
        if^s fits^love.graphics.Shader {
            let^useIndex = pal fits^love.graphics.Texture and^self^.isIndexed(i)
            if^pal fits^love.graphics.Texture { s.send("palette", pal) }
            s.send("row", row)
            s.send("indexed", if^useIndex: 1 el^: 0;)
            s.send("tint", { tr, tg, tb })
            love.graphics.setShader(s)
        }
    },

    # Draws the columns [from, from + width) of image i with the image's
    # top-left at (x, y) (mirrored: the image flipped left to right in place),
    # for gauges and the HUD (palette row 0); tinted by (tr, tg, tb).
    drawPart = p^self^, i:number^, x:number^, y:number^, from:number^, width:number^, mirrored:bool^, tr:number^, tg:number^, tb:number^{
        let^tex = self^.image(i)
        if^!(tex fits^love.graphics.Texture) or^width <= 0 { return^}
        self^.useShader(i, 0, tr, tg, tb)
        let^w, h = tex.getDimensions()
        let^q = love.graphics.newQuad(from, 0, width, h, w, h)
        if^mirrored {
            love.graphics.draw(tex, q, x + w - from, y, 0, -1, 1)
        else^:
            love.graphics.draw(tex, q, x + from, y)
        }
        love.graphics.setShader()
    },

    # Draws image i with its bottom-centre at (x, y), coloured by palette row
    # and tinted by (tr, tg, tb), mirrored when sx / sy is -1.
    draw = p^self^, i:number^, x:number^, y:number^, row:number^, sx:number^, sy:number^, tr:number^, tg:number^, tb:number^{
        let^tex = self^.image(i)
        if^!(tex fits^love.graphics.Texture) { return^}
        self^.useShader(i, row, tr, tg, tb)
        let^w, h = tex.getDimensions()
        love.graphics.draw(tex, x, y - h + (h / 2).floor(), 0, sx, sy, (w / 2).floor(), (h / 2).floor())
        love.graphics.setShader()
    },
}

# One Sheet per folder, shared by every fighter, object and layer made from
# it: its images load once (a fighter made anew, such as a select screen
# portrait on each cursor move, read them all over again).
var^sheets : t^{[string^]:Sheet|nil^} = {}

public^let^sheetFor = p^dir:string^-> Sheet{
    let^known = sheets[dir]
    if^known != nil^ { return^known }
    let^s = Sheet.new(dir)
    sheets[dir] := s
    return^s
}
