# A fighter and the vocabulary its skills are written in.
#
# A skill is a p^ taking the fighter and the block to start at; it yields once
# per frame (100 fps, as in FM2K). The procedures below are FM2K's blocks:
#
#   show  I     image, held for `wait` frames (yieldable: call with await^)
#   hurt / body / fd  FD   hurt box (body = push box) in a slot
#   hit / fa    FA  attack box in a slot
#   motion / move   M   velocity and gravity, 1/100 px per frame
#   sound       S
#   jump        SG  to another skill (then return^)
#   call        SC / SF  another skill as a subroutine (await^ it)
#   v setv addv V   variables
#   chance      Rnd
#   on          DS  jump when an event happens while this skill runs
#   spawn / cancel / reactions / gauges / effects implement the other blocks
#
# Boxes are centred on (x, y) from the fighter's feet, with half extents (w, h)
# (TechnicalDocuments/0002). Skills are generated by tools/fm2k_convert/gen_skills.py
# (TechnicalDocuments/0005).
module^vp.fighter

import^love.graphics
import^love.audio
import^love.math
import^std.math

require^"arena.lh"
require^"sprite.lh"
require^"shake.lh"
require^"afterimage.lh"

public^let^Box = def^{
    self^{ x = 0, y = 0, w = 0, h = 0, power = 0, body = false^, vulnerable = true^, rate = 100, flags = "", connected = false^ },
    override^new = f^x:number^, y:number^, w:number^, h:number^{
        self^{ x = x, y = y, w = w, h = h }
    },
}

# One entry of the character's command table: the input steps (FM2K direction
# codes and button bitmasks, a = 1 ... f = 32), the frames they must fall
# within, and the skill for each state (0: none). A step's mode: 0 a press,
# 3 a rotation of the stick `amount` times (1 and 2, repeat and charge, are
# not used by this game).
public^let^Command = def^{
    self^{
        name = "", time = 0, air = 0, stand = 0, far = 0, crouch = 0,
        dirs : t^{number^[]} = {}, buttons : t^{number^[]} = {},
        modes : t^{number^[]} = {}, amounts : t^{number^[]} = {},
    },
}

# How many frames of input a fighter remembers.
let^HISTORY = 1024

# A running skill: one that ends (runs off its E block) or one that loops forever.
public^let^Skill = c^{p^-> nil^}|c^{p^-> nil^ -> -}

public^let^Fighter = def^{
    self^{
        abstract^sheet : vp.sprite.Sheet,
        soundDir = "",
        palette = 0,
        x = 0, y = 0,               # feet, world px
        ground = 0,
        vx = 0, vy = 0,             # px per frame, world direction
        ax = 0, ay = 0,             # px per frame per frame
        facing = 1,
        image = -1, ix = 0, iy = 0, # current I block (-1: none yet)
        turnX = false^, turnY = false^, fixed = false^,   # its flags (fixed: ignoreDirection)
        trail : vp.afterimage.Trail|nil^ = nil^,
        blend = 0, alpha = 1,       # COLOR: 0 normal, 1 half, 2 add, 3 subtract, 4 custom alpha
        tintR = 0, tintG = 0, tintB = 0,    # COLOR: added to each channel (-1..1)
        scrollX = 1, scrollY = 1,   # stage layers: how far they move with the camera
        loopX = false^, loopY = false^,
        level = 0,
        hurts : t^{[number^]:Box|nil^} = {},
        hits : t^{[number^]:Box|nil^} = {},
        sounds : t^{[number^]:love.audio.Source|nil^} = {},
        soundsByPath : t^{[string^]:love.audio.Source|nil^} = {},
        externalIntroPortrait = false^,
        mutedSounds : t^{[number^]:bool^|nil^} = {},
        soundsGen = -1,             # the scene (vp.arena) its sounds were loaded in
        vars : t^{[number^]:number^|nil^} = {},
        onSkill : t^{[string^]:number^|nil^} = {},
        onBlock : t^{[string^]:number^|nil^} = {},
        skills : t^{[number^]:(p^Self^^, number^ -> c^{p^-> nil^};)|nil^} = {},
        skillName = "",
        skillNo = -1,               # FM2K number of the running skill (-1: not a generated one)
        skill : Skill|nil^= nil^,
        jumpSkill = -1, jumpBlock = 0, eventPending = false^,
        levels : t^{[number^]:number^|nil^} = {},
        commands : t^{Command[]} = {},
        inDirs : t^{[number^]:number^|nil^} = {},    # numpad directions, forward = 6
        inPress : t^{[number^]:number^|nil^} = {},   # buttons pressed that frame
        inputFrame = 0,
        cancelWhen = "", cancelFrom = 0, cancelTo = 0, cancelSkill = -1,
        hitConfirmed = false^,
        cancelByHit = false^,       # an FA with the "cancel" flag connected
        # Being hit: reaction number -> own hit skill / spark skill (the .player
        # table), and the running attack's R block (stand, crouch, air) x (hit, guard).
        reactHit : t^{[number^]:number^|nil^} = {},
        reactSpark : t^{[number^]:number^|nil^} = {},
        onHit : t^{number^[]} = { 0, 0, 0 },
        onGuard : t^{number^[]} = { 0, 0, 0 },
        life = 1000, lifeMax = 1000,
        guardDamageRate = 0,        # attacker settings.hRatio, percent of FA power
        # The special gauge: `special` points, `specialPer` to a stock (one
        # level), at most `stockMax` stocks.
        special = 0, specialPer = 300, stockMax = 5,
        enemy : Fighter|nil^= nil^, # the opponent (GP adds to its gauges too)
        guarding = false^,          # set by the controller: holding back where a guard is allowed
        blocking = false^,          # guard reaction; unlike hitstun, another guard is allowed
        receiving = false^,         # hit reaction; FA While Receiving excludes this target
        guardCrouched = false^,
        attackConnected = false^,   # shared by the currently active group of FA slots
        frameAttack = false^, frameThrow = false^, frameReceived = false^,
        hitEventTarget : Fighter|nil^ = nil^,
        combo = 0,                  # hits taken since it was last free to move
        comboMarker : number^|nil^= nil^, # hit-time V128 snapshot for a combo display only
        stop = 0,                   # hitstop frames left: the fighter is frozen
        cornerPush = 0,             # displacement returned by the opponent's wall clamp
        # Objects (O blocks): effects, voices, sparks, projectiles. They run the
        # owner's skills as fighters of their own.
        dir = "",
        owner : Fighter|nil^= nil^,
        objects : t^{Fighter[]} = {},
        slots : t^{[number^]:Fighter|nil^} = {},    # managed numbers 0-9
        baseDepth = 75,             # main actor depth before RP +/- 1
        depth = 75,                 # draw order: characters are 70-80, below is behind them
        parent : Fighter|nil^= nil^,   # what spawned it (the character or another object)
        follow = false^,            # "parent": moves with its parent
        shadowOf = false^,          # a character's shadow: stays under it, on the floor
        system = false^,            # the system file's (the round, the HUD): no managed numbers
        onScreen = false^,          # "picXY": x, y are in view coordinates
        lastOwnerX = 0, lastOwnerY = 0, # the parent's position last frame
        spins = 0,
        waitTimer = 0,              # FM2K's I-block timer (see `hold`)
        # Where x may go, on the ground and in the air (the stage's walls and
        # the view's edges; the controller sets them each frame).
        minX = -1000000, maxX = 1000000, minXAir = -1000000, maxXAir = 1000000,
        wallMinX : number^|nil^ = nil^, wallMaxX : number^|nil^ = nil^,
        alive = true^,
    },
    # A procedure: the images come from the folder's shared Sheet.
    override^new = p^dir:string^, x:number^, y:number^{
        self^{
            sheet = vp.sprite.sheetFor(dir),
            dir = dir,
            soundDir = $"{dir}/sounds",
            x = x,
            y = y,
            ground = y
        }
    },

    airborne = f^self^{ self^.y < self^.ground },

    # FM2K keeps wall recoil in the player's pending displacement, not its M
    # velocity. Only a living main fighter in a hit/guard reaction returns it.
    confineMotion = p^self^{
        self^.x += self^.cornerPush
        self^.cornerPush := 0
        let^wallEvent = (self^.onSkill["wallHitting"] ?? -1) >= 0
        let^lo = if^wallEvent: self^.wallMinX ?? self^.minX el^self^.airborne(): self^.minXAir el^: self^.minX;
        let^hi = if^wallEvent: self^.wallMaxX ?? self^.maxX el^self^.airborne(): self^.maxXAir el^: self^.maxX;
        let^clamped = self^.x.clamp(lo, hi)
        let^returned = clamped - self^.x
        let^e = self^.enemy
        if^returned != 0 and^self^.owner is^nil^ and^!self^.system and^self^.life > 0 and^(self^.receiving or^self^.blocking) and^e != nil^ {
            # Original state bits: hit = 8, guard = 12. Do not push an
            # opponent who is themselves taking a hit (a trade).
            if^!e.receiving or^e.blocking { e.charOf().cornerPush += returned }
        }
        self^.x := clamped
        # Dispatch performs the event transition's common initialization.
        if^returned != 0 and^self^.owner is^nil^ and^!self^.system and^(self^.onSkill["wallHitting"] ?? -1) >= 0 {
            self^.fire("wallHitting")
        }
    },

    # FA versus FA contact precedes ordinary damage (original 0x40EB60).
    # Zero-power boxes are also detectors: Eri's dash meets the enemy shadow.
    offsetAgainst = p^self^, other:Fighter{
        if^!self^.alive or^!other.alive or^self^.onScreen != other.onScreen { return^ }
        if^self^.charOf() = other.charOf() or^other.receiving or^other.blocking { return^ }
        for^slot, a in^self^.hits {
            if^a != nil^ and^a.w > 0 and^a.h > 0 {
                for^otherSlot, b in^other.hits {
                    if^b != nil^ and^b.w > 0 and^b.h > 0 {
                        let^al, at, aw, ah = self^.rect(a)
                        let^bl, bt, bw, bh = other.rect(b)
                        if^al < bl + bw and^bl < al + aw and^at < bt + bh and^bt < at + ah {
                            let^empty = a.power = 0 and^b.power = 0
                            let^mine = (self^.onSkill["offsetWay"] ?? -1) >= 0
                            let^theirs = (other.onSkill["offsetWay"] ?? -1) >= 0
                            if^empty or^mine or^theirs {
                                # A registered clash consumes both sets of FA,
                                # even when only one actor has a DS handler.
                                self^.hits := {} other.hits := {}
                                if^!empty {
                                    if^mine { self^.fire("offsetWay") }
                                    if^theirs { other.fire("offsetWay") }
                                }
                            }
                            # FA flag 0x8000 is projectile cancellation, not
                            # the parser's halfed (0x0004, guard chip) flag.
                            let^cancel = !empty and^(a.power = 0 or^b.power = 0) and^(a.flags.find("projectileCancel") != nil^ or^b.flags.find("projectileCancel") != nil^)
                            if^cancel {
                                self^.hits[slot] := nil^ other.hits[otherSlot] := nil^
                                if^self^.owner != nil^ { self^.fire("defending") }
                                if^other.owner != nil^ { other.fire("defending") }
                            }
                            if^empty or^mine or^theirs or^cancel { return^ }
                        }
                    }
                }
            }
        }
    },
    # Cross-team pairs only; objects include the built-in contact shadows.
    offsetTeamAgainst = p^self^, other:Fighter{
        self^.offsetAgainst(other)
        for^o in^other.objects { self^.offsetAgainst(o) }
        for^o in^self^.objects {
            o.offsetAgainst(other)
            for^target in^other.objects { o.offsetAgainst(target) }
        }
    },

    # FD collide boxes participate at any height, including air hit reactions.
    # Jumping over works when their vertical intervals no longer overlap.
    pushAgainst = p^self^, other:Fighter{
        let^dir = if^self^.x < other.x: -1 el^self^.x > other.x: 1 el^: -self^.facing;
        var^distance = 0
        for^slot, a in^self^.hurts {
            if^a != nil^ and^a.body and^a.w > 0 and^a.h > 0 {
                for^otherSlot, b in^other.hurts {
                    if^b != nil^ and^b.body and^b.w > 0 and^b.h > 0 {
                        let^al, at, aw, ah = self^.rect(a)
                        let^bl, bt, bw, bh = other.rect(b)
                        if^al < bl + bw and^bl < al + aw and^at < bt + bh and^bt < at + ah {
                            let^amount = if^dir < 0: al + aw - bl el^: bl + bw - al;
                            distance := std.math.max(distance, amount)
                        }
                    }
                }
            }
        }
        if^distance <= 0 { return^ }
        let^lo = if^self^.airborne(): self^.minXAir el^: self^.minX;
        let^hi = if^self^.airborne(): self^.maxXAir el^: self^.maxX;
        let^otherLo = if^other.airborne(): other.minXAir el^: other.minX;
        let^otherHi = if^other.airborne(): other.maxXAir el^: other.maxX;
        let^room = std.math.max(0, if^dir < 0: self^.x - lo el^: hi - self^.x;)
        let^otherRoom = std.math.max(0, if^dir < 0: otherHi - other.x el^: other.x - otherLo;)
        # When only one side is airborne, move that side first. A rising or
        # falling body must not drag the grounded fighter backwards.
        let^share = if^self^.airborne() = other.airborne(): distance / 2 el^self^.airborne(): distance el^: 0;
        var^mine = std.math.min(share, room)
        let^theirs = std.math.min(distance - mine, otherRoom)
        mine := std.math.min(distance - theirs, room)
        self^.x += dir * mine
        other.x -= dir * theirs
    },

    # Replaces the running skill, as the engine does when it picks one: attack
    # boxes and event handlers go, and on the ground so does motion.
    # Task variables belong to the object, not to an individual animation.
    play = p^self^, name:string^, co:Skill {
        self^.jumpSkill := -1
        self^.eventPending := false^
        self^.skillName := name
        self^.skillNo := -1
        self^.skill := co
        self^.hits := {}
        self^.attackConnected := false^
        self^.blocking := false^
        self^.receiving := false^
        self^.onSkill := {}
        self^.onBlock := {}
        self^.cancelWhen := ""
        # an attack's reactions are its own skill's R (a throw has none: its
        # grab gave the last attack's reaction, a jump C's, and はるか flinched)
        self^.onHit := { 0, 0, 0 }
        self^.onGuard := { 0, 0, 0 }
        self^.hitConfirmed := false^
        self^.cancelByHit := false^
        self^.waitTimer := 0
        if^!self^.airborne() {
            self^.vx := 0
            self^.ax := 0
            self^.vy := 0
            self^.ay := 0
        }
    },

    # Starts generated skill n from its first block, as the engine does.
    begin = p^self^, n:number^{
        let^proc = self^.skills[n]
        if^proc != nil^ {
            self^.play($"#{n}", proc(self^, 0))
            self^.skillNo := n
        }
    },

    # Hit/guard reactions replace the previous pose's FD slots. Script jumps
    # within the reaction carry boxes through SG, but DS starts a new pose.
    beginReaction = p^self^, n:number^{
        if^self^.skills[n] != nil^ {
            self^.hurts := {}
            self^.begin(n)
        }
    },
    # Collision writes a pending reaction; the old boxes survive this pass
    # so the other side can still land a simultaneous hit (0x40F541).
    queueReaction = p^self^, n:number^{
        if^self^.skills[n] != nil^ {
            self^.jumpSkill := n self^.jumpBlock := 0 self^.eventPending := true^
            self^.waitTimer := 0
        }
    },

    # Continues in generated skill n at block b, as a script jump does:
    # boxes, motion, variables and handlers carry over.
    start = p^self^, n:number^, b:number^{
        let^proc = self^.skills[n]
        if^proc != nil^ {
            self^.skillName := $"#{n}"
            self^.skillNo := n
            self^.skill := proc(self^, b)
        }
    },

    # True when the running skill has run off its end (FM2K's E block).
    finished = p^self^-> bool^{
        let^co = self^.skill
        if^co fits^c^{p^-> nil^} { return^co.done() and^self^.jumpSkill < 0 }
        return^co is^nil^
    },

    advance = p^self^{
        let^co = self^.skill
        if^co fits^c^{p^-> nil^} {
            if^!co.done() {
                if^co.started() { co.resume() else^: co.start() }
            }
        elseif^co fits^c^{p^-> nil^ -> -}:
            if^co.started() { co.resume() else^: co.start() }
        }
    },

    # Asks for an event's handler (DS) to take over. A handler is used up when
    # it fires (FM2K consumes the DS slot): otherwise a landing that jumps to a
    # hop would land again and again (the stun's chicks chirped for ever).
    fire = p^self^, event:string^{
        let^n = self^.onSkill[event]
        let^b = self^.onBlock[event]
        if^n? and^b? {
            self^.jumpSkill := n
            self^.jumpBlock := b
            self^.eventPending := true^
            # It cuts the running I block's wait short: FM2K zeroes the timer
            # (else the new skill's first wait adds onto what was left).
            self^.waitTimer := 0
            self^.onSkill[event] := nil^
            self^.onBlock[event] := nil^
        }
    },

    # DS is a fresh animation entry, unlike SG/COM. Preserve reaction state,
    # and task variables (original 0x412327, 0x410D50).
    dispatch = p^self^{
        var^hops = 0
        repeat^while^self^.jumpSkill >= 0 and^hops < 16 {
            let^n = self^.jumpSkill
            let^b = self^.jumpBlock
            self^.jumpSkill := -1
            if^self^.eventPending {
                self^.eventPending := false^
                self^.hurts := {}
                self^.hits := {}
                self^.attackConnected := false^
                self^.onSkill := {}
                self^.onBlock := {}
                self^.onHit := {0, 0, 0} self^.onGuard := {0, 0, 0}
                self^.cancelWhen := ""
                self^.cancelFrom := 0
                self^.cancelTo := 0
                self^.cancelSkill := -1
                self^.waitTimer := 0
                if^self^.owner is^nil^ and^!self^.system and^self^.y = self^.ground and^self^.vy = 0 {
                    self^.vx := 0
                    self^.ax := 0
                    self^.ay := 0
                }
            }
            self^.start(n, b)
            self^.advance()
            hops += 1
        }
    },

    # Standalone scene actors retain the move-then-script convenience step.
    # Combat calls stepScript / moveStep separately around collision passes.
    step = p^self^{ self^.moveStep() self^.stepScript() },
    moveStep = p^self^{
        if^!self^.alive { return^ }
        if^self^.stop <= 0 {
            self^.vx += self^.ax self^.x += self^.vx
            self^.vy += self^.ay self^.y += self^.vy
        }
        self^.confineMotion()
    },
    # Landing is NOT a generic pending DS: it clears only collision slots,
    # preserves R, C and the other DS registrations, and consumes landing.
    land = p^self^{
        self^.y := self^.ground
        self^.vx := 0 self^.ax := 0 self^.vy := 0 self^.ay := 0
        let^n = self^.onSkill["landing"]
        let^b = self^.onBlock["landing"]
        if^n != nil^ and^b != nil^ {
            self^.off("landing")
            self^.hurts := {} self^.hits := {} self^.attackConnected := false^
            self^.waitTimer := 0
            self^.start(n, b)
        }
        if^self^.owner is^nil^ { self^.receiving := false^ self^.blocking := false^ }
    },
    stepScript = p^self^{
        if^!self^.alive { return^ }
        self^.spins := 0
        # Pending DS precedes hitstop and landing (original 0x412327).
        if^self^.eventPending and^self^.jumpSkill >= 0 {
            self^.dispatch()
            self^.captureTrail()
            return^
        }
        if^self^.stop > 0 {
            self^.captureTrail()
            self^.stop -= 1
            let^co = self^.skill
            if^co fits^c^{p^-> nil^} {
                if^!co.started() { self^.advance() }
            elseif^co fits^c^{p^-> nil^ -> -}:
                if^!co.started() { self^.advance() }
            }
            return^
        }
        if^self^.y >= self^.ground and^self^.vy > 0 and^(self^.owner is^nil^ or^self^.onSkill["landing"] != nil^) { self^.land() }
        if^self^.owner != nil^ and^!self^.onScreen and^!self^.system and^!self^.shadowOf {
            if^self^.x < -50 or^self^.x > 1330 or^self^.y < -500 or^self^.y > 980 { self^.alive := false^ return^ }
        }
        self^.captureTrail()
        if^self^.jumpSkill < 0 { self^.advance() }
        self^.dispatch()
    },

    captureTrail = p^self^{
        let^trail = self^.trail
        if^trail is^nil^ { return^ }
        let^face = if^self^.fixed: 1 el^: self^.facing;
        trail.capture(self^.image, self^.x + self^.ix * self^.facing, self^.y + self^.iy,
            if^self^.turnX: -face el^: face;, if^self^.turnY: -1 el^: 1;)
    },

    # The image faces the fighter's way unless the I block says ignoreDirection;
    # turnX / turnY mirror it once more.
    # A "picXY" object lives in view coordinates and stays put on the screen.
    draw = p^self^{
        if^!self^.alive { return^ }
        let^face = if^self^.fixed: 1 el^: self^.facing;
        let^sx = if^self^.turnX: -face el^: face;
        let^sy = if^self^.turnY: -1 el^: 1;
        let^ox = if^self^.onScreen: viewX el^: 0;
        let^oy = if^self^.onScreen: viewY el^: 0;
        let^trail = self^.trail
        if^trail != nil^ {
            trail.draw(self^.sheet, self^.palette, ox, oy, self^.tintR, self^.tintG, self^.tintB, (1 - self^.alpha) * 32)
        }
        vp.sprite.setBlend(self^.blend, self^.alpha)
        self^.sheet.draw(self^.image,
            ox + self^.x + self^.ix * self^.facing,
            oy + self^.y + self^.iy, self^.palette,
            sx, sy,
            self^.tintR, self^.tintG, self^.tintB
        )
        vp.sprite.resetBlend()
    },

    # A box in world coordinates: left, top, width, height.
    rect = f^self^, b:Box -> (number^, number^, number^, number^){
        return^self^.x + b.x * self^.facing - b.w, self^.y + b.y - b.h, b.w * 2, b.h * 2
    },

    drawBoxes = p^self^{
        for^slot, b in^self^.hurts {
            if^b fits^Box {
                if^b.body {
                    love.graphics.setColor(1, 1, 0, 0.9)
                else^:
                    love.graphics.setColor(0.2, 0.5, 1, 0.9)
                }
                let^l, t, w, h = self^.rect(b)
                love.graphics.rectangle(love.graphics.DrawMode.line, l, t, w, h)
            }
        }
        love.graphics.setColor(1, 0.1, 0.1, 0.9)
        for^slot, b in^self^.hits {
            if^b fits^Box {
                let^l, t, w, h = self^.rect(b)
                love.graphics.rectangle(love.graphics.DrawMode.line, l, t, w, h)
            }
        }
        love.graphics.setColor(1, 1, 1, 1)
    },

    # SG to another skill: the fighter switches once this skill returns.
    jump = p^self^, n:number^, b:number^{
        self^.eventPending := false^
        self^.jumpSkill := n
        self^.jumpBlock := b
    },
    # SC / SF: another skill as a subroutine. `await^ call(me, n, b)`.
    call = p^self^, n:number^, b:number^-> c^{p^-> nil^} {
        let^proc = self^.skills[n]
        if^proc != nil^ { return^proc(self^, b) }
        return^nothing(self^, b)
    },
    # Guards a loop that might go round without showing an image: after enough
    # rounds in one frame it waits for the next (FM2K would hang).
    spin = p^self^-> bool^{
        self^.spins += 1
        return^self^.spins > 300          # FM2K's own per-frame limit
    },
    # Settings: the skill's priority level (what C blocks cancel against).
    settings = p^self^, level:number^{
        self^.level := level
    },
    # DS: while this skill runs, jump to (n, b) when `event` happens.
    # Events: landing, attacking, defending, wallHitting, offsetWay, whileThrowDo.
    on = p^self^, event:string^, n:number^, b:number^{
        self^.onSkill[event] := n
        self^.onBlock[event] := b
    },
    addCommand = p^self^, name:string^, time:number^, air:number^, stand:number^, far:number^, crouch:number^, dirs:t^{number^[]}, buttons:t^{number^[]}, modes:t^{number^[]}, amounts:t^{number^[]}{
        let^c = Command.new()
        c.name := name
        c.time := time
        c.air := air
        c.stand := stand
        c.far := far
        c.crouch := crouch
        c.dirs := dirs
        c.buttons := buttons
        c.modes := modes
        c.amounts := amounts
        self^.commands.push^(c)
    },
    skillLevel = p^self^, n:number^-> number^{
        return^self^.levels[n] ?? 0
    },
    inputDirection = f^self^-> number^{ self^.inDirs[self^.inputFrame % HISTORY] ?? 5 },
    # DB: test the current owner's directional state, not a new press.
    # Condition 1 is grounded (despite some references calling it guarding).
    basicCondition = f^self^, condition:number^, inverted:bool^, disabled:bool^-> bool^{
        let^dir = self^.charOf().inputDirection()
        let^down = dir >= 1 and^dir <= 3
        let^grounded = self^.y >= self^.ground
        let^met = !disabled and^(for^condition:
            when^1: grounded
            when^2: grounded and^!down
            when^3: grounded and^down
            when^4: dir = 3 or^dir = 6 or^dir = 9
            when^5: dir = 1 or^dir = 4 or^dir = 7
            when^6: dir >= 7 and^dir <= 9
            when^7: down
            when^8: dir = 5
            other^: false^
        ;)
        return^met != inverted
    },
    # Remembers this frame's input: a numpad direction relative to the way the
    # fighter faces (6 = forward) and the buttons newly pressed.
    record = p^self^, dir:number^, pressed:number^{
        self^.inputFrame += 1
        let^slot = self^.inputFrame % HISTORY
        self^.inDirs[slot] := dir
        self^.inPress[slot] := pressed
    },
    # Scan the command's entire history window, including its final press.
    # Original 0x410719 -> 0x410863 also scans older frames on a final-step miss.
    # A rotation step (mode 3) is met by the stick going round `amount` times.
    entered = p^self^, time:number^, dirs:t^{number^[]}, buttons:t^{number^[]}, modes:t^{number^[]}, amounts:t^{number^[]}-> bool^{
        var^step = dirs.length^ - 1
        if^step < 0 { return^false^ }
        let^limit = std.math.min(std.math.max(time, 1), HISTORY)
        var^age = 0
        repeat^while^step >= 0 and^age < limit and^self^.inputFrame - age >= 1 {
            let^slot = (self^.inputFrame - age) % HISTORY
            let^d = self^.inDirs[slot] ?? 5
            let^p = self^.inPress[slot] ?? 0
            if^(modes[step] ?? 0) = 3 {
                # going back through the frames, collect the sides the stick visited
                turnSeen := addSides(turnSeen, sideOf(d))
                if^turnSeen = 15 {
                    turnRounds += 1
                    turnSeen := 0
                    if^turnRounds >= std.math.max(amounts[step] ?? 1, 1) {
                        turnRounds := 0
                        step -= 1
                    }
                }
            elseif^dirFits(dirs[step] ?? 0, d) and^hasButtons(p, buttons[step] ?? 0):
                step -= 1
            }
            age += 1
        }
        turnSeen := 0
        turnRounds := 0
        return^step < 0
    },
    # COM inside a skill.
    command = p^self^, time:number^, dirs:t^{number^[]}, buttons:t^{number^[]}-> bool^{
        # Original 0x410A50 scans the entire time window, without consuming
        # input. Objects read the player's history just like the main fighter.
        let^player = self^.owner ?? self^
        var^step = dirs.length^ - 1
        if^step < 0 or^time <= 0 { return^false^ }
        let^limit = std.math.min(time, HISTORY)
        var^age = 0
        repeat^while^step >= 0 and^age < limit and^player.inputFrame - age >= 1 {
            let^slot = (player.inputFrame - age) % HISTORY
            if^dirFits(dirs[step] ?? 0, player.inDirs[slot] ?? 5) and^hasButtons(player.inPress[slot] ?? 0, buttons[step] ?? 0) {
                step -= 1
            }
            age += 1
        }
        return^step < 0
    },
    # The skill the command table gives for this frame's input, or 0.
    fromCommands = p^self^, crouching:bool^-> number^{
        for^c in^self^.commands {
            if^self^.entered(c.time, c.dirs, c.buttons, c.modes, c.amounts) {
                let^n = if^self^.airborne(): c.air el^crouching: c.crouch el^: c.stand;
                if^n > 0 { return^n }
            }
        }
        return^0
    },
    # Input is recorded during recovery/hitstop. Only execute once the move
    # can start; a completed skill must not retain its old cancel restriction.
    takeCommand = p^self^, crouching:bool^-> bool^{
        if^self^.stop > 0 or^self^.eventPending { return^false^ }
        let^n = self^.fromCommands(crouching)
        if^n > 0 and^(n != self^.skillNo or^self^.finished()) and^self^.mayStart(n) {
            self^.begin(n)
            return^true^
        }
        return^false^
    },
    # Whether skill n may start now (the FM2002 compendium's reading of C):
    #   - the running skill is level 0 (a basic move), or
    #   - the last C block allows it: "uncond" any time, "hits" once an attack has
    #     connected; into skill `cancelSkill`, or any skill of level from..to.
    #     "fails" means not cancellable at all.
    #   - an FA with the "cancel" flag connected, and n is of a higher level.
    #     (Assumption: which skills an FA cancel allows is not documented.)
    mayStart = p^self^, n:number^-> bool^{
        if^self^.stop > 0 or^self^.eventPending { return^false^ }
        if^self^.finished() { return^true^ }
        let^current = self^.skillLevel(self^.skillNo)
        if^current = 0 { return^true^ }
        if^self^.cancelByHit and^self^.skillLevel(n) > current { return^true^ }
        let^when = self^.cancelWhen
        let^met = when = "uncond" or^(when = "hits" and^self^.hitConfirmed)
        if^!met { return^false^ }
        if^self^.cancelSkill >= 0 { return^n = self^.cancelSkill }
        if^self^.cancelFrom = 0 and^self^.cancelTo = 0 { return^false^ }
        let^lv = self^.skillLevel(n)
        return^lv >= self^.cancelFrom and^lv <= self^.cancelTo
    },
    # An attack box of this fighter's connected.
    landed = p^self^, box:Box{
        if^box.flags.find("cancel") != nil^ { self^.cancelByHit := true^ }
        self^.hitConfirmed := true^
        # Main-actor DS waits for the entire collision pass; objects dispatch
        # immediately. C hit-confirm remains sticky across frames.
        if^self^.owner != nil^ { self^.fire("attacking") }
    },
    resetHitEvents = p^self^{
        self^.frameAttack := false^ self^.frameThrow := false^ self^.frameReceived := false^
        self^.hitEventTarget := nil^
    },
    # Original 0x40FFC0: resolve main-actor hits after collision and movement.
    # Another pending DS wins. A trade suppresses this event, while a throw
    # contact overrides ordinary attacking when both handlers are registered.
    finishHitEvents = p^self^{
        let^target = self^.hitEventTarget
        if^self^.owner != nil^ or^self^.eventPending or^!self^.frameAttack or^target is^nil^ { return^ }
        if^target.frameAttack or^!target.frameReceived { return^ }
        self^.fire("attacking")
        if^self^.frameThrow { self^.fire("whileThrowDo") }
    },
    # One row of the .player's hit-junction table.
    reactsWith = p^self^, reaction:number^, hit:number^, spark:number^{
        self^.reactHit[reaction] := hit
        self^.reactSpark[reaction] := spark
    },
    # 0 standing, 1 crouching, 2 in the air.
    posture = p^self^, crouched:bool^-> number^{
        if^self^.airborne() { return^2 }
        return^if^crouched: 1 el^: 0;
    },
    updateGuard = p^self^, held:bool^, crouched:bool^, free:bool^{
        self^.guarding := held and^(!self^.receiving or^self^.blocking) and^(free or^self^.blocking)
        self^.guardCrouched := crouched
    },
    # A normal FA update changes geometry, not the attack's hit allowance.
    # Cont.Hits explicitly permits another group. Every active box in a group
    # is spent together, so multiple overlapping boxes cannot hit each frame.
    canHit = p^self^, box:Box, target:Fighter-> bool^{
        if^!self^.alive or^!target.alive or^self^.onScreen != target.onScreen or^self^.charOf() = target.charOf() or^box.w <= 0 or^box.h <= 0 { return^false^ }
        if^box.connected or^(self^.attackConnected and^box.flags.find("combo") is^nil^) { return^false^ }
        if^target.shadowOf or^target.system { return^false^ }
        if^target.owner != nil^ { return^true^ }
        # These FA flags exclude target states; they do not grant extra hits.
        if^target.receiving and^box.flags.find("duringReceipt") != nil^ { return^false^ }
        if^target.blocking and^box.flags.find("noSkyDetection") != nil^ { return^false^ }
        if^!target.airborne() and^box.flags.find("noDetection") != nil^ { return^false^ }
        if^target.airborne() and^box.flags.find("duringGuard") != nil^ { return^false^ }
        return^true^
    },
    # `atk`'s attack box `box` has reached `def`. `crouched` says whether the
    # defender is in a crouching skill. The defender goes to the hit (or guard)
    # skill its own table gives for the reaction the attacker's R block names,
    # facing the attacker; a hit takes power x damage rate / 100 off its life.
    # Both freeze for the attacker's PS hitstop. Answers whether it was guarded,
    # and the spark skill for the reaction (0: none): the ATTACKER's table gives
    # it, and it runs as the attacker's (measured in the original: ゆい's jump C
    # on はるか, reaction 20, spawned ゆい's #317 -- はるか's table names 315;
    # TechnicalDocuments/0008).
    #
    # R's guard slot is what a guarding defender gets. Where it is the same as the
    # hit slot, the attack cannot be guarded in that posture: a low kick has the
    # hit reaction in its standing-guard slot, an air attack in its crouching one.
    struck = p^self^, box:Box, def:Fighter, rate:number^, crouched:bool^, hurtFlags:string^-> bool^, number^{
        # Hitting an O actor consumes the attack and notifies its attacker,
        # but does not damage the owner or run the main fighter's reactions.
        if^def.owner != nil^ {
            self^.attackConnected := true^
            for^slot, active in^self^.hits { if^active != nil^ { active.connected := true^ } }
            self^.landed(box)
            self^.fire("attacking")
            return^false^, 0
        }
        let^pose = def.posture(if^def.guarding: def.guardCrouched el^: crouched;)
        let^onHit = self^.onHit[pose] ?? 0
        let^onGuard = self^.onGuard[pose] ?? 0
        let^guardable = box.flags.find("guardFail") is^nil^ and^onGuard > 0 and^onGuard != onHit
        let^guarded = def.guarding and^guardable
        let^reaction = if^guarded: onGuard el^: onHit;
        let^skill = def.reactHit[reaction] ?? 0
        def.facing := if^self^.x < def.x: -1 el^: 1;
        if^skill > 0 { def.queueReaction(skill) }
        def.blocking := guarded
        def.receiving := !guarded and^skill > 0
        if^!guarded {
            def.life := std.math.max(def.life - box.power * rate / 100, 0)
        elseif^box.power > 0 and^box.flags.find("halfed") != nil^:
            # 0x40F6AE: guard chip uses the attacker's hRatio, not FD rate.
            let^damage = std.math.max((box.power * self^.charOf().guardDamageRate / 100).floor(), 1)
            def.life := std.math.max(def.life - damage, 0)
        }
        self^.attackConnected := true^
        for^slot, active in^self^.hits {
            if^active != nil^ { active.connected := true^ }
        }
        if^guarded {
            self^.fire("defending")
        else^:
            self^.landed(box)
            let^throwContact = hurtFlags.find("throw") != nil^
            def.charOf().frameReceived := true^
            if^self^.owner is^nil^ or^throwContact {
                let^root = self^.charOf()
                root.frameAttack := true^
                root.frameThrow := root.frameThrow or^throwContact
                root.hitEventTarget := def.charOf()
            }
        }
        let^source = self^.owner ?? self^
        return^guarded, source.reactSpark[reaction] ?? 0
    },
    # DS with no skill: stop handling `event`.
    off = p^self^, event:string^{
        self^.onSkill[event] := nil^
        self^.onBlock[event] := nil^
    },
    home = f^self^, n:number^-> t^{[number^]:number^|nil^} {
        if^n < 64 { return^self^.vars }
        if^n >= 128 and^n < 192 { return^systemVars }
        return^(self^.owner ?? self^).vars
    },
    # Data variables (read only): 192 / 193 own x / y, 194 / 195 the map (camera)
    # position, 196 / 197 the parent's (spawner's) x / y, 198 the round time in
    # seconds, 199 the round number.
    v = f^self^, n:number^-> number^{
        for^n:
        when^128: self^.comboMarker ?? (self^.home(n)[n] ?? 0)
        when^192: integer(self^.x)
        when^193: integer(self^.y)
        when^194: integer(viewX)
        when^195: integer(viewY)
        when^196: integer((self^.parent ?? self^).x)
        when^197: integer((self^.parent ?? self^).y)
        when^198: (std.math.max(roundFrames - 1, 0) / 100).floor() # a frame behind the display
        when^199: roundNumber
        other^:self^.home(n)[n] ?? 0
        ;
    },
    setv = p^self^, n:number^, value:number^{
        let^t = self^.home(n)
        t[n] := signedWord(value)
    },
    addv = p^self^, n:number^, value:number^{
        let^t = self^.home(n)
        t[n] := (signedWord(t[n] ?? 0) + signedWord(value)).clamp(-30000, 30000)
    },
    # Rnd: a roll of 0..total-1 above `above`.
    chance = p^self^, total:number^, above:number^-> bool^{
        return^love.math.random(0, total - 1) > above
    },
    # The character a skill belongs to (an object's gauges are its owner's).
    charOf = f^self^-> Fighter { self^.owner ?? self^ },
    # GL / GS are forks: when the condition holds the skill goes on, otherwise it
    # goes to the block's skill ("if it failed"). The generated code jumps when
    # these answer true, so they answer whether the condition FAILED.
    #
    # GL: life above `amount` (isMore), or below it. (The compendium's wording is
    # ambiguous; this reading makes "GL more 0" the usual "still alive" check.)
    lifeGauge = f^self^, isMore:bool^, amount:number^-> bool^{
        let^life = self^.charOf().life
        let^met = if^isMore: life > amount el^: life < amount;
        return^!met
    },
    # GS: the special gauge's level (whole stocks, 0-9) at least `level` (isMore),
    # or below it; when it holds, `amount` stocks are added (negative: spent).
    specialGauge = p^self^, level:number^, isMore:bool^, amount:number^-> bool^{
        let^b = self^.charOf()
        let^stocks = (b.special / b.specialPer).floor()
        # "more" is strictly more: this game starts everyone at 4 stocks (shown as
        # 0) and its supers check "more than 4" (shown as 1 or more).
        let^met = if^isMore: stocks > level el^: stocks < level;
        if^met and^amount != 0 {
            b.special := (b.special + amount * b.specialPer).clamp(0, b.specialPer * b.stockMax)
        }
        return^!met
    },
    # Holds an I block's image for `wait`, as FM2K's timer does: the block ADDS
    # 100 per wait unit to the timer (0 sets it to -1 and does not hold), and each
    # frame the timer loses 100 and the script moves on once it is below zero. The
    # timer keeps what the last image left (-100, or -1 after a wait of 0), so the
    # first image of a skill the engine starts holds N + 1 frames and the ones
    # after it N (measured: #21's 9-frame walk).
    hold = p^self^, wait:number^{
        if^wait = 0 {
            self^.waitTimer := -1
            return^
        }
        self^.waitTimer += 100 * wait
        repeat^while^true^ {
            yield^
            if^self^.waitTimer < 0 { return^}
            self^.waitTimer -= 100
            if^self^.waitTimer < 0 { return^}
        }
    },
    # I — show image i, its bottom-centre at (x, y) from the feet.
    show = p^self^, i:number^, wait:number^, x:number^, y:number^{
        self^.image := i
        self^.ix := x
        self^.iy := y
        self^.turnX := false^
        self^.turnY := false^
        self^.fixed := false^
        await^self^.hold(wait)
    },
    # I with its flags: "turnX" / "turnY" mirror the image, "ignoreDirection"
    # draws it the same way whichever way the fighter faces.
    showEx = p^self^, i:number^, wait:number^, x:number^, y:number^, flags:string^{
        self^.image := i
        self^.ix := x
        self^.iy := y
        self^.turnX := flags.find("turnX") != nil^
        self^.turnY := flags.find("turnY") != nil^
        self^.fixed := flags.find("ignoreDirection") != nil^
        await^self^.hold(wait)
    },
    # FD — a hurt box. `body` marks the push box (FM2K's "collide").
    hurt = p^self^, slot:number^, x:number^, y:number^, w:number^, h:number^{
        self^.hurts[slot] := Box.new(x, y, w, h)
    },
    body = p^self^, slot:number^, x:number^, y:number^, w:number^, h:number^{
        let^b = Box.new(x, y, w, h)
        b.body := true^
        b.vulnerable := false^
        self^.hurts[slot] := b
    },
    # FD with its flags spelled out ("damaged collide throw") and damage rate.
    fd = p^self^, slot:number^, x:number^, y:number^, w:number^, h:number^, flags:string^, rate:number^{
        let^b = Box.new(x, y, w, h)
        b.body := flags.find("collide") != nil^
        b.vulnerable := flags.find("damaged") != nil^ or^flags.find("throw") != nil^
        b.flags := flags
        b.rate := rate
        self^.hurts[slot] := b
    },
    noHurt = p^self^, slot:number^{
        self^.hurts[slot] := nil^
    },
    # FA — an attack box with its damage.
    hit = p^self^, slot:number^, x:number^, y:number^, w:number^, h:number^, power:number^{
        let^b = Box.new(x, y, w, h)
        b.power := power
        self^.hits[slot] := b
    },
    # FA with its flags ("cancel combo guardFail ...").
    fa = p^self^, slot:number^, x:number^, y:number^, w:number^, h:number^, power:number^, flags:string^{
        let^b = Box.new(x, y, w, h)
        b.power := power
        b.flags := flags
        self^.hits[slot] := b
    },
    noHit = p^self^, slot:number^{
        self^.hits[slot] := nil^
        # Replacing one FA preserves the group. Removing its last box ends it:
        # a later attack (including a non-Cont.Hits finisher) is a new group.
        for^n, active in^self^.hits {
            if^active != nil^ { return^ }
        }
        self^.attackConnected := false^
    },
    # M in full. Flags: "add" adds to the current values; "keepVX" / "keepVY" /
    # "keepAX" / "keepAY" leave that one as it is.
    motion = p^self^, vx:number^, vy:number^, ax:number^, ay:number^, flags:string^{
        let^add = flags.find("add") != nil^
        let^dvx = vx * SPEED * self^.facing
        let^dvy = vy * SPEED
        let^dax = ax * GRAVITY * self^.facing
        let^day = ay * GRAVITY
        if^flags.find("keepVX") is^nil^{ self^.vx := if^add: self^.vx + dvx el^: dvx; }
        if^flags.find("keepVY") is^nil^{ self^.vy := if^add: self^.vy + dvy el^: dvy; }
        if^flags.find("keepAX") is^nil^{ self^.ax := if^add: self^.ax + dax el^: dax; }
        if^flags.find("keepAY") is^nil^{ self^.ay := if^add: self^.ay + day el^: day; }
    },
    # M — horizontal speed and gravity only (the hand-written sample's form).
    move = p^self^, vx:number^, ax:number^{
        self^.motion(vx, 0, ax, 0, "keepVY keepAY")
    },
    # Both sound caches belong to the same scene as their playback sources.
    freshSounds = p^self^{
        if^self^.soundsGen != vp.arena.generation() {
            self^.sounds := {}
            self^.soundsByPath := {}
            self^.soundsGen := vp.arena.generation()
        }
    },
    # S — a sound by its FM2K number.
    sound = p^self^, n:number^{
        if^(self^.owner ?? self^).mutedSounds[n] = true^ { return^ }
        if^logSounds {
            let^who = if^self^.owner?: "object" el^: "fighter";
            print($"sound {n} by {who} {self^.skillName}")
        }
        # A character and its objects share its sounds; a new scene (vp.arena)
        # disposed the last one's.
        let^holder = self^.owner ?? self^
        holder.freshSounds()
        var^src = holder.sounds[n]
        if^src is^nil^{
            # A looping sound (the music) is long: streamed, looped over the whole
            # file (the tracks have no loop points and end in a fade).
            let^e = soundEntry(self^.dir, n)
            let^loop = e fits^t^{ endlessLoop : bool^ } and^e.endlessLoop
            let^path = vp.sprite.assetPath(self^.dir, e) ?? $"{self^.soundDir}/{n:%04d}.wav"
            let^loaded = vp.arena.sound(path, loop)
            holder.sounds[n] := loaded
            src := loaded
        }
        if^src fits^love.audio.Source {
            src.stop()
            src.play()
        }
    },
    # ---------------------------------------------------------------------------
    # Shared definitions have their own numbering. Cache playback by path on
    # the owner, keeping opponents independent without cloning on every play.
    soundFrom = p^self^, dir:string^, n:number^{
        let^e = soundEntry(dir, n)
        let^path = vp.sprite.assetPath(dir, e)
        if^path is^nil^ { return^ }
        let^holder = self^.owner ?? self^
        holder.freshSounds()
        var^src = holder.soundsByPath[path]
        if^src is^nil^{
            let^loop = e fits^t^{endlessLoop:bool^} and^e.endlessLoop
            src := vp.arena.sound(path, loop)
            holder.soundsByPath[path] := src
        }
        if^src fits^love.audio.Source { src.stop() src.play() }
    },
    # A new object of `me`'s character running skill n from block b, at (x, y) in
    # the world. It shares the character's skills, images and sounds, faces the
    # way `me` faces, and is drawn at `depth`.
    makeObject = p^self^, n:number^, b:number^, x:number^, y:number^, depth:number^-> Fighter{
        let^root = self^.owner ?? self^
        let^o = newObjectFighter(root.dir, x, y)
        o.owner := root
        o.parent := self^
        o.sheet := root.sheet
        o.sounds := root.sounds
        o.skills := root.skills
        o.levels := root.levels
        o.palette := root.palette
        o.facing := self^.facing
        o.ground := root.ground        # objects stand on the same floor (FM2K keeps a ground Y per object)
        o.depth := depth
        o.system := root.system
        o.lastOwnerX := self^.x
        o.lastOwnerY := self^.y
        o.start(n, b)
        root.objects.push^(o)
        return^o
    },
    # O — an object running skill (n, b), placed (x, y) from `me` (mirrored with
    # its facing), or at (x, y) of the view with "picXY". Flags: "out" one layer
    # above its spawner (capped at 127), "point" at `depth`, neither
    # just behind its spawner (its depth - 1: measured in the original, a select
    # screen face at 80 spawns its big face at 79; "ROUND 1"'s shadow goes behind
    # its letters so);
    # "parent" moves it with its owner. An occupied managed slot branches the
    # CALLER to outSkill (true return); without that branch it replaces/deletes.
    #
    # The system file's objects (the round, the HUD) are placed at (x, y) of the
    # view whatever the flags.
    spawn = p^self^, n:number^, b:number^, x:number^, y:number^, slot:number^, depth:number^, outSkill:number^, outBlock:number^, flags:string^-> bool^{
        let^root = self^.owner ?? self^
        let^managed = !root.system and^flags.find("unCond") is^nil^ and^slot >= 0 and^slot < 10
        if^managed {
            let^old = root.slots[slot]
            if^old fits^Fighter and^old.alive {
                if^outSkill > 0 { return^true^ }
                old.alive := false^
            }
            root.slots[slot] := nil^
        }
        # O with no new skill still deletes the existing managed object.
        if^n <= 0 { return^false^ }
        # "picXY" objects, and whatever they spawn, live in view coordinates.
        # A preloaded round presentation owns the #31 face animation.
        if^root.externalIntroPortrait and^self^.skillNo = 31 and^depth = 117 and^flags.find("picXY") != nil^ { return^false^ }
        let^atView = flags.find("picXY") != nil^ or^root.system
        let^wx = if^atView: x el^: self^.x + x * self^.facing;
        let^wy = if^atView: y el^: self^.y + y;
        let^below = std.math.max(self^.depth - 1, 10)
        let^d = if^flags.find("out") != nil^: std.math.min(self^.depth + 1, 127) el^flags.find("point") != nil^: depth el^: below;
        let^o = self^.makeObject(n, b, wx, wy, d)
        o.follow := flags.find("parent") != nil^
        o.onScreen := atView or^self^.onScreen
        if^managed { root.slots[slot] := o }
        return^false^
    },
    # The character's shadow: its built-in shadow skill run as an object that
    # stays at the character's x on the floor (FM2K runs it by itself).
    castShadow = p^self^, n:number^{
        let^o = self^.makeObject(n, 0, self^.x, self^.ground, 10)
        o.shadowOf := true^
    },
    # One frame of a character's objects; finished ones are dropped.
    # A "parent" object moves with whatever spawned it (FM2K's child attach).
    stepObjects = p^self^{ self^.advanceObjects(false^) },
    stepObjectScripts = p^self^{ self^.advanceObjects(true^) },
    advanceObjects = p^self^, scriptOnly:bool^{
        var^live : t^{Fighter[]} = {}
        for^o in^self^.objects {
            # The original stage-face script maintained variable 75 by comparing
            # the two players. Our HUD does not run that script. Keep its support
            # branch input relative to the actor's spawn orientation instead;
            # movement and attack scripts retain their explicit turnX branches.
            let^support = self^.slots[5]
            let^enemy = self^.enemy
            if^support fits^Fighter and^enemy fits^Fighter and^support.alive {
                let^delta = (enemy.x - self^.x) * support.facing
                if^delta.abs() > 1 { self^.setv(75, if^delta < 0: 1 el^: 0;) }
            }
            let^par = o.parent ?? self^
            if^!scriptOnly and^o.shadowOf {
                o.x := self^.x
                o.y := self^.ground
                o.facing := self^.facing
            elseif^!scriptOnly and^o.follow:
                o.x += par.x - o.lastOwnerX
                o.y += par.y - o.lastOwnerY
            }
            if^scriptOnly { o.stepScript()
            else^:
                o.lastOwnerX := par.x o.lastOwnerY := par.y
                o.step()
            }
            if^o.alive and^!o.finished() { live.push^(o) else^: o.alive := false^ }
        }
        self^.objects := live
        for^slot, o in^self^.slots {
            if^o != nil^ and^!o.alive { self^.slots[slot] := nil^ }
        }
    },
    moveObjects = p^self^{
        for^o in^self^.objects {
            if^o.alive {
                let^par = o.parent ?? self^
                if^o.shadowOf {
                    o.x := self^.x o.y := self^.ground o.facing := self^.facing
                elseif^o.follow:
                    o.x += par.x - o.lastOwnerX o.y += par.y - o.lastOwnerY
                }
                o.lastOwnerX := par.x o.lastOwnerY := par.y
                o.moveStep()
            }
        }
    },
    # Draws a character's objects in the world behind (front = false) or in
    # front of the characters. "picXY" objects in front are left to
    # drawScreenObjects; those behind (a super's backdrop, depth 68) stay here.
    drawObjects = p^self^, front:bool^{
        for^o in^self^.objects {
            let^inFront = o.depth > 80
            if^inFront = front and^!(o.onScreen and^inFront) { o.draw() }
        }
    },
    # Draws a character's "picXY" objects in front of the characters (its part
    # of the HUD, a super's cut-in) over everything, stage foreground included.
    # Call it in view coordinates.
    drawScreenObjects = p^self^{
        let^x, y = viewX, viewY
        setView(0, 0)
        for^o in^self^.objects {
            if^o.onScreen and^o.depth > 80 { o.draw() }
        }
        setView(x, y)
    },
    # C — cancel window: into skill `n` (or any skill of level from..to) on "hits" / "uncond" / "fails".
    # The last one run is the one in force.
    cancel = p^self^, when:string^, from:number^, to:number^, n:number^{
        self^.cancelWhen := when
        self^.cancelFrom := from
        self^.cancelTo := to
        self^.cancelSkill := n
    },
    # R — the reaction numbers (the game's shared hit-junction list) this skill's
    # attack gives the opponent, by the opponent's posture, on a hit and on a guard.
    # 0: none (a guard of 0 cannot be guarded).
    reactions = p^self^, hitStand:number^, hitCrouch:number^, hitAir:number^, guardStand:number^, guardCrouch:number^, guardAir:number^{
        self^.onHit := { hitStand, hitCrouch, hitAir }
        self^.onGuard := { guardStand, guardCrouch, guardAir }
    },
    # PS adds to each character's remaining stop; zero leaves it unchanged
    # (original EXE 0x413648-0x413653 and 0x4136F6-0x4136FB).
    # Hitstop comes from the
    # hit reactions' own PS (#135 "hit super": 0 for itself, 16 for the attacker,
    # who stands while it is thrown up), a super's pause from its start (#292:
    # the opponent 110). An object's PS does nothing.
    pause = p^self^, mine:number^, theirs:number^{
        if^self^.owner != nil^ { return^}
        self^.stop += mine
        let^e = self^.enemy
        if^e != nil^ { e.stop += theirs }
    },
    # GP — add to this character's and the opponent's life and special gauge
    # (special in points; a stock is `specialPer` of them).
    addGauges = p^self^, life:number^, special:number^{
        self^.life := (self^.life + life).clamp(0, self^.lifeMax)
        self^.special := (self^.special + special).clamp(0, self^.specialPer * self^.stockMax)
    },
    gauges = p^self^, life:number^, special:number^, enemyLife:number^, enemySpecial:number^{
        let^b = self^.charOf()
        b.addGauges(life, special)
        let^e = b.enemy
        if^e != nil^ { e.addGauges(enemyLife, enemySpecial) }
    },
    # EB — screen / background effect.
    screen = p^self^, fading:number^, r:number^, g:number^, b:number^, a:number^, duration:number^, flags:string^, xt:number^, xa:number^, xd:number^, yt:number^, ya:number^, yd:number^{
        vp.shake.horizontal.start(xt, xa, xd)
        vp.shake.vertical.start(yt, ya, yd)
    },
    # AI — afterimages.
    afterimage = p^self^, count:number^, time:number^, option:number^, fading:number^, r:number^, g:number^, b:number^, a:number^{
        if^self^.trail is^nil^ and^count > 0 and^time > 0 { self^.trail := vp.afterimage.Trail.new() }
        let^trail = self^.trail
        if^trail != nil^ { trail.configure(count, time, option, fading, r, g, b, a) }
    },
    # COLOR — how this is blended: 0 normal, 1 half transparent, 2 additive,
    # 3 subtractive, 4 alpha (32 - a) / 32; r g b are added to the colour.
    color = p^self^, option:number^, r:number^, g:number^, b:number^, a:number^{
        self^.blend := option
        self^.alpha := if^option = 1: 0.5 el^option = 4: std.math.max(32 - a, 0) / 32 el^: 1;
        self^.tintR := tintOf(r)
        self^.tintG := tintOf(g)
        self^.tintB := tintOf(b)
    },
    # A stage layer's settings: how far it scrolls with the camera, in percent
    # ("scrollX" / "scrollY" on, else it stays put on screen), and whether its
    # image repeats ("loopX" / "loopY").
    layer = p^self^, x:number^, y:number^, flags:string^{
        self^.scrollX := if^flags.find("scrollX") != nil^: x / 100 el^: 0;
        self^.scrollY := if^flags.find("scrollY") != nil^: y / 100 el^: 0;
        self^.loopX := flags.find("loopX") != nil^
        self^.loopY := flags.find("loopY") != nil^
    },
    # E in a stage layer: the layer is gone (one that runs past its last block
    # keeps showing its last image instead).
    vanish = p^self^{
        self^.alive := false^
    },
    # RC 0 is explicitly ignored by the original (0x412EA1). All current
    # data uses 0. Nonzero common-pose definitions are not yet imported.
    commonImage = p^self^, n:number^, x:number^, y:number^, flags:string^{
    },
    # RP — hit junction: puts the opponent into its own skill for reaction n
    # (its hit-junction table), standing at (x, y) from `me` (x mirrored by me's
    # facing) and facing me ("turnX": the other way). How throws work: the
    # throw's #250 sends the opponent to "throw start" (#71) in front of the
    # thrower, then to the throw's own reaction. Depth is base +/- 1
    # (original 0x413065); the flag does not change who receives the reaction.
    hitJunction = p^self^, n:number^, x:number^, y:number^, flags:string^{
        if^self^.owner != nil^ or^self^.system { return^ }
        let^root = self^.charOf()
        let^who = root.enemy
        if^who is^nil^ { return^}
        let^target : Fighter = who
        let^skill = target.reactHit[n] ?? 0
        let^inward = flags.find("in") != nil^
        self^.depth := self^.baseDepth + (if^inward: 1 el^: -1;)
        target.depth := target.baseDepth + (if^inward: -1 el^: 1;)
        target.x := self^.x + x * self^.facing
        target.y := self^.y + y
        target.facing := if^flags.find("turnX") != nil^: self^.facing el^: -self^.facing;
        # RP clears the caller's collision slots, not just the target's pose.
        self^.hurts := {} self^.hits := {} self^.attackConnected := false^
        if^skill > 0 { target.beginReaction(skill) }
        target.stop := 0
        target.receiving := true^
    },
}

# ---------------------------------------------------------------------------
# Control flow

# A skill that does nothing: what calling a missing skill gives.
let^nothing = p^me:Fighter, at:number^{ _yield^ }

# ---------------------------------------------------------------------------
# Commands and cancels

# FM2K direction codes: 0 any, 1 neutral, 2-9 the eight directions from
# forward round, 10-13 a whole side (back / up / forward / down).
let^SINGLE : t^{number^[]} = { 0, 5, 6, 3, 2, 1, 4, 7, 8, 9 }

let^dirFits = f^code:number^, d:number^-> bool^{
    if^code = 0 { return^true^ }
    if^code <= 9 { return^d = (SINGLE[code] ?? 0) }
    if^code = 10 { return^d = 7 or^d = 4 or^d = 1 }
    if^code = 11 { return^d = 7 or^d = 8 or^d = 9 }
    if^code = 12 { return^d = 9 or^d = 6 or^d = 3 }
    if^code = 13 { return^d = 1 or^d = 2 or^d = 3 }
    return^false^
}

# All the buttons in `need` are in `got` (both bitmasks).
let^hasButtons = f^got:number^, need:number^-> bool^{
    var^bit = 1
    repeat^while^bit <= 32 {
        if^(need / bit).floor() % 2 = 1 and^(got / bit).floor() % 2 = 0 { return^false^ }
        bit *= 2
    }
    return^true^
}

# The stick went round: forward, down, back and up each at least once.
let^sideOf = f^d:number^-> number^{
    # a bit per side: 1 forward, 2 down, 4 back, 8 up
    var^m = 0
    if^d = 9 or^d = 6 or^d = 3 { m += 1 }
    if^d = 3 or^d = 2 or^d = 1 { m += 2 }
    if^d = 1 or^d = 4 or^d = 7 { m += 4 }
    if^d = 7 or^d = 8 or^d = 9 { m += 8 }
    return^m
}

let^addSides = f^seen:number^, sides:number^-> number^{
    var^out = seen
    var^bit = 1
    repeat^while^bit <= 8 {
        if^(sides / bit).floor() % 2 = 1 and^(out / bit).floor() % 2 = 0 { out += bit }
        bit *= 2
    }
    return^out
}

var^turnSeen = 0
var^turnRounds = 0

# ---------------------------------------------------------------------------
# Being hit

# ---------------------------------------------------------------------------
# Variables (V). 0-15 task (this object), 64-79 character, 128-143 system,
# 192- read-only data.

# Where a variable lives: task variables are the running object's own (an
# object's are its own), character variables are shared by a character and all
# its objects, system variables by everyone.
var^systemVars : t^{[number^]:number^|nil^} = {}

# Clears the system variables (128-143), as a new match does.
public^let^clearSystemVars = p^{
    systemVars := {}
}

# The round's clock (frames left; FM2K counts 100 a second) and number (1-).
var^roundFrames = 0
var^roundNumber = 1

public^let^setRound = p^frames:number^, number:number^{
    roundFrames := frames
    roundNumber := number
}

# ---------------------------------------------------------------------------
# Image, boxes, motion, sound

# FM2K's scales at the default game speed (16.16 fixed point): speeds are
# value * 655 / 65536 px per frame (about 1/100), gravities value * 393 / 65536
# px per frame per frame (about 1/167). Horizontal values are forward-positive
# and turned into the world direction here, when the M block runs.
let^SPEED = 655 / 65536
let^GRAVITY = 393 / 65536

# Debugging: when on, every S block is printed with who played it.
var^logSounds = false^
public^let^setSoundLog = p^on:bool^{ logSounds := on }

# Sound n's entry in its folder's sounds.lton: whether it loops
# ("endlessLoop", FM2K's sound flag 0x10; TechnicalDocuments/0014) and where
# its file is (its folder, or assets/shared: TechnicalDocuments/0020).
let^soundEntry = p^dir:string^, n:number^-> any^{
    let^l = vp.sprite.listing($"{dir}/sounds.lton")
    if^l is^nil^{ return^nil^ }
    return^l[n]
}

# ---------------------------------------------------------------------------
# Objects (O)

# Where the view's top-left is in the world, for "picXY" objects.
var^viewX = 0
var^viewY = 0
public^let^setView = p^x:number^, y:number^{
    viewX := x
    viewY := y
}

# A COLOR channel byte is a signed offset of -32..32 (246 = -10): as a
# fraction added to the channel.
let^tintOf = f^byte:number^-> number^{
    let^signed = if^byte >= 128: byte - 256 el^: byte;
    return^signed.clamp(-32, 32) / 32
}

# Construct through the completed definition (its sheet is initialized by new).
let^newObjectFighter = p^dir:string^, x:number^, y:number^-> Fighter{ return^Fighter.new(dir, x, y) }

# Original V: fixed-point coordinates truncate toward zero; storage and
# operands are signed words. Only addition saturates (0x4138F0-0x41391D).
let^integer = f^value:number^-> number^{ if^value < 0: value.ceil() el^: value.floor(); }
let^signedWord = f^value:number^-> number^{
    let^n = integer(value)
    let^word = n - (n / 65536).floor() * 65536
    return^if^word >= 32768: word - 65536 el^: word;
}
