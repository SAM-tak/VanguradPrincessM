# Weighted original command patterns with an explicit L^ decision scheduler.
module^vp.cpu

import^love.math
require^"fighter.lh"
require^"resource.lh"

let^Step = t^{skills:t^{number^[]}, amount:number^, direction:number^, repeatInput:bool^}
let^Pattern = t^{weight:number^, near:number^, far:number^, air:bool^, enemyAir:bool^, steps:t^{Step[]}}

public^let^Input = t^{dir:number^, skill:number^, guard:bool^, buttons:number^}

public^let^Brain = def^{
    self^{
        patterns : t^{Pattern[]} = {},
        steps : t^{Step[]} = {},
        at = 0, remaining = 0, cooldown = 0, level = 20, actions = 0,
        supportCooldown = 100,
    },
    override^new = p^name:string^, level:number^{
        let^raw = vp.resource.data($"assets/characters/{name}/cpu.lton")
        if^!(raw fits^t^{patterns:t^{Pattern[]}}) { panic^$"Missing CPU patterns: {name}" }
        self^{patterns = raw.patterns, level = level}
    },

    reset = p^self^{ self^.steps := {} self^.at := 0 self^.remaining := 0 self^.cooldown := 20 self^.supportCooldown := 100 },
    step = p^self^, me:vp.fighter.Fighter, enemy:vp.fighter.Fighter-> Input {
        let^distance = (me.x - enemy.x).abs()
        var^out : Input = {dir = 5, skill = 0, guard = false^, buttons = 0}
        if^me.stop > 0 or^me.blocking {
            out.dir := me.inputDirection()
            out.guard := out.dir % 3 = 1
            return^out
        }
        if^self^.remaining <= 0 {
            if^self^.at < self^.steps.length^ { self^.at += 1 }
            if^self^.at >= self^.steps.length^ {
                self^.steps := {}
                self^.at := 0
                self^.cooldown -= 1
                if^self^.cooldown <= 0 {
                    var^eligible : t^{Pattern[]} = {}
                    var^weight = 0
                    for^p in^self^.patterns {
                        if^p.weight > 0 and^distance >= p.near and^distance <= p.far and^p.air = me.airborne() and^p.enemyAir = enemy.airborne() {
                            eligible.push^(p)
                            weight += p.weight
                        }
                    }
                    if^weight > 0 {
                        var^roll = love.math.random(1, weight)
                        for^p in^eligible {
                            roll -= p.weight
                            if^roll <= 0 { self^.steps := p.steps break^ }
                        }
                    }
                    self^.cooldown := (35 - self^.level * 0.25).clamp(4, 35)
                }
            }
            let^next = self^.steps[self^.at]
            if^next != nil^ { self^.remaining := next.amount.clamp(1, 180) }
        }
        let^s = self^.steps[self^.at]
        if^s != nil^ {
            out.dir := if^s.direction >= 1 and^s.direction <= 9: s.direction el^: 5;
            if^s.repeatInput or^self^.remaining = s.amount.clamp(1, 180) {
                let^variant = if^me.airborne(): 0 el^out.dir <= 3: 3 el^distance > 160 and^(s.skills[2] ?? 0) > 0: 2 el^: 1;
                out.skill := s.skills[variant] ?? 0
            }
            self^.remaining -= 1
        else^:
            out.dir := if^distance > 100: 6 el^: 5;
            if^distance < 220 and^enemy.hits.length^ > 0 and^love.math.random(0, 100) < self^.level {
                out.dir := 4
                out.guard := true^
            }
        }
        if^out.dir % 3 = 1 { out.guard := true^ }
        self^.supportCooldown -= 1
        # Body command patterns do not supply D. Feed a real D press through
        # the support HUD's COM checks: its gauge costs and lockouts stay intact.
        let^support = me.slots[5]
        if^self^.supportCooldown <= 0 and^support != nil^ and^support.alive and^me.life > 0 and^me.v(71) >= 10 and^me.v(76) < 99 and^!me.receiving {
            var^dir = 5
            if^distance < 220 and^enemy.hits.length^ > 0 { dir := 4
            elseif^enemy.airborne(): dir := 2
            elseif^distance > 280: dir := 6
            elseif^love.math.random(0, 1) = 1: dir := 3
            }
            out.dir := dir
            out.buttons := 8
            out.guard := dir = 4
            self^.supportCooldown := (280 - self^.level * 2).clamp(80, 280)
        }
        return^out
    },
}
