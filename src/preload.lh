# Scene preparation loads metadata, shared script dependencies, then media.
# The old scene keeps running until this arena is complete.
module^vp.preload
require^"resource.lh"
require^"script.lh"
require^"sprite.lh"

let^Directory = t^{ path:string^, portrait:bool^, support:number^, winner:number^}
let^SUPPORTS = {"えこ", "シエラ", "ジュリエット", "かなえ", "ヒルダ"}
public^let^Load = def^{ self^{
    abstract^batch : vp.resource.Batch,
    directories : t^{Directory[]} = {},
    dependenciesQueued = false^,
    assetsQueued = false^,
}, override^new = f^name:string^{ self^{batch = vp.resource.Batch.new(name)} } }

public^let^add = p^l:Load, dir:string^, portrait:bool^{
    l.directories.push^({path = dir, portrait = portrait, support = -1, winner = -1})
    let^file = if^portrait: "portrait.lton" el^: "script.lton";
    vp.resource.request(l.batch, $"{dir}/{file}", "script", false^)
    vp.resource.request(l.batch, $"{dir}/images.lton", "lton", false^)
    vp.resource.request(l.batch, $"{dir}/sounds.lton", "lton", false^)
}

# A match selects media independently for each player, even with the same owner.
public^let^character = p^l:Load, dir:string^, support:number^{
    add(l, dir, false^)
    let^d = l.directories[l.directories.length^ - 1]
    if^d? { d.support := support }
}

public^let^victory = p^l:Load, dir:string^, winner:number^{
    add(l, dir, false^)
    let^d = l.directories[l.directories.length^ - 1]
    if^d? { d.winner := winner }
    vp.resource.request(l.batch, $"{dir}/preload.lton", "lton", false^)
}

let^media = p^l:Load, dir:string^, op:string^, n:number^{
    let^file = if^op = "I": "images" el^: "sounds";
    let^list = vp.resource.data($"{dir}/{file}.lton")
    if^list is^nil^ { return^ }
    let^e = list[n]
    let^path = vp.sprite.assetPath(dir, e)
    if^path is^nil^ { return^ }
    if^op = "I" {
        if^e fits^t^{format:string^} and^e.format = "indexed" {
            vp.resource.request(l.batch, $"{dir}/palettes.png", "image", false^)
        }
        vp.resource.request(l.batch, path, "image", false^)
    else^:
        let^loop = e fits^t^{endlessLoop:bool^} and^e.endlessLoop
        vp.resource.request(l.batch, path, "sound", loop)
    }
}

let^assets = p^l:Load, d:Directory {
    let^dir = d.path
    let^file = if^d.portrait: "portrait.lton" el^: "script.lton";
    let^sc = vp.script.load($"{dir}/{file}")
    if^d.winner >= 0 {
        let^lists = vp.resource.data($"{dir}/preload.lton")
        if^lists? {
            for^row:any^ in^lists {
                if^row fits^t^{winner:number^, images:t^{number^[]}, sounds:t^{number^[]}} and^row.winner = d.winner {
                    for^n in^row.images { media(l, dir, "I", n) }
                    for^n in^row.sounds { media(l, dir, "S", n) }
                    return^
                }
            }
        }
        # Unknown winner codes retain the conservative full-list behavior.
    }
    # Keep all owner skills (including Kurumi's collaboration attacks), but
    # only the selected support's bodies and the common helper definitions.
    # Membership comes from raw bindings, which survive the linked-script cache.
    if^d.support >= 0 and^sc? {
        let^selected = SUPPORTS[d.support - 101] ?? ""
        for^n, sk in^sc.skills {
            let^raw = sc.raw[n]
            var^wanted = true^
            if^raw fits^t^{support:string^} {
                wanted := raw.support = selected or^raw.support = "common"
            }
            if^wanted {
                let^source = if^sk.media = "": dir el^: sk.media;
                for^b in^sk.blocks {
                    if^b.op = "I" or^b.op = "S" { media(l, source, b.op, b.n[0] ?? 0) }
                }
            }
        }
        return^
    }
    let^images = vp.resource.data($"{dir}/images.lton")
    let^sounds = vp.resource.data($"{dir}/sounds.lton")
    if^images? {
        var^wanted : t^{number^[]} = {}
        if^d.portrait and^sc? { wanted := vp.script.imagesFrom(sc, 25)
        else^:
            for^e:any^ in^images { if^e? { wanted.push^(index^) } }
        }
        for^n in^wanted {
            let^e = images[n]
            if^e fits^t^{format:string^} and^e.format = "indexed" {
                vp.resource.request(l.batch, $"{dir}/palettes.png", "image", false^)
            }
            let^path = vp.sprite.assetPath(dir, images[n])
            if^path? { vp.resource.request(l.batch, path, "image", false^) }
        }
    }
    var^used : t^{[number^]:bool^|nil^} = {}
    if^d.portrait and^sc? {
        for^sk in^sc.skills {
            for^b in^sk.blocks { if^b.op = "S" { used[b.n[0] ?? 0] := true^ } }
        }
    }
    if^sounds? {
        for^n:number^, e:any^ in^sounds {
            if^!d.portrait or^used[n]? {
                let^path = vp.sprite.assetPath(dir, e)
                let^loop = e fits^t^{endlessLoop:bool^} and^e.endlessLoop
                if^path? { vp.resource.request(l.batch, path, "sound", loop) }
            }
        }
    }
}

public^let^ready = p^l:Load -> bool^{
    if^l.batch.error != "" { panic^$"Asset loading failed: {l.batch.error}" }
    if^!vp.resource.ready(l.batch) { return^false^ }
    if^!l.dependenciesQueued {
        l.dependenciesQueued := true^
        var^supportMedia = false^
        var^allSupports = false^
        for^d in^l.directories {
            let^file = if^d.portrait: "portrait.lton" el^: "script.lton";
            let^sc = vp.resource.script($"{d.path}/{file}")
            if^sc? {
                for^sk in^sc.skills {
                    let^ref = sk.binding
                    if^ref != nil^ or^sk.media != "" {
                        supportMedia := true^
                        if^d.support < 0 { allSupports := true^ }
                    }
                    if^ref != nil^ { vp.resource.request(l.batch, $"assets/supports/{ref.support}/script.lton", "script", false^) }
                }
            }
        }
        if^allSupports { add(l, "assets/supports/common", false^)
        elseif^supportMedia:
            vp.resource.request(l.batch, "assets/supports/common/images.lton", "lton", false^)
            vp.resource.request(l.batch, "assets/supports/common/sounds.lton", "lton", false^)
        }
        if^!vp.resource.ready(l.batch) { return^false^ }
    }
    if^!l.assetsQueued {
        l.assetsQueued := true^
        for^d in^l.directories { assets(l, d) }
    }
    return^vp.resource.ready(l.batch)
}
