# Bounded background IO. LTON graphs move through task.await; LOVE objects
# cross a channel by reference. Only the main thread creates GPU textures.
module^vp.resource
import^std.task
import^std.channel
import^std.lton
import^love.image
import^love.graphics
import^love.audio
import^love.timer
require^"arena.lh"
require^"scriptdata.lh"

public^let^Batch = def^{
    self^{
        abstract^arena : vp.arena.Arena,
        pending = 0,
        cancelled = false^,
        error = "",
        seen : t^{[string^]:bool^|nil^} = {},
    },
    override^new = f^name:string^{ self^{arena = vp.arena.Arena.new(name)} },

    request = p^self^, path:string^, kind:string^, loop:bool^{
        let^key = $"{kind}:{path}"
        if^self^.cancelled or^self^.seen[key] != nil^ { return^ }
        self^.seen[key] := true^
        if^kind = "lton" and^tables[path] != nil^ { return^ }
        if^kind = "script" and^scripts[path] != nil^ { return^ }
        let^j = Job.new(self^)
        j.path := path
        j.kind := kind
        j.loop := loop
        self^.pending += 1
        queue.push^(j)
    },
    ready = f^self^-> bool^{ return^self^.pending = 0 and^!self^.cancelled and^self^.error = "" },
    cancel = p^self^{
        self^.cancelled := true^
        self^.arena.dispose()
    },
}

let^Job = def^{
    self^{
        abstract^batch : Batch, path = "", kind = "", loop = false^,
        tableTask : std.task.Task<t^{}|nil^>|nil^= nil^,
        mediaTask : std.task.Task<string^|nil^>|nil^= nil^,
        scriptTask : std.task.Task<vp.scriptdata.Data|nil^>|nil^= nil^,
        channel : std.channel.Channel|nil^= nil^,
    },
    override^new = f^batch:Batch{ self^{batch = batch} },

    launch = p^self^{
        # Capture only immutable job arguments and this job's channel, never
        # the scene, arena, queues, or main-thread caches.
        let^path = self^.path
        let^definition = metadataPath(path)
        let^kind = self^.kind
        let^loop = self^.loop
        let^parse = vp.scriptdata.parse
        let^out = try^std.channel.new()
        self^.channel := out
        if^kind = "script" {
            # Keep the worker's result type; erasing it forces a recursive
            # fits Data scan of every block on the receiving thread.
            self^.scriptTask := try^std.task.async(p^-> vp.scriptdata.Data|nil^{
                let^raw = std.lton.load(definition) catch^nil^
                if^raw fits^t^{} { return^parse(raw) }
                return^nil^
            })
            return^
        }
        if^kind = "lton" {
            self^.tableTask := try^std.task.async(p^-> t^{}|nil^{
                let^raw = std.lton.load(definition) catch^nil^
                if^raw fits^t^{} { return^raw }
                return^nil^
            })
            return^
        }
        self^.mediaTask := try^std.task.async(p^-> string^|nil^{
            if^kind = "image" {
                let^pixels = try^love.image.newImageData(path)
                try^out.push(pixels)
            else^:
                let^source = try^love.audio.newSource(path, if^loop or^kind = "stream": love.audio.SourceType.stream el^: love.audio.SourceType.static;)
                source.setLooping(loop)
                try^out.push(source)
            }
            return^nil^
        catch^:
            return^it^.message
        })
    catch^:
        self^.batch.error := $"{self^.path}: {it^.message}"
        let^ch = self^.channel
        if^ch != nil^ { ch.dispose() self^.channel := nil^ }
    },
    hasTask = f^self^-> bool^{
        self^.scriptTask != nil^ or^self^.tableTask != nil^ or^self^.mediaTask != nil^
    },
    done = p^self^-> bool^{
        let^scriptTask = self^.scriptTask
        if^scriptTask != nil^ { return^scriptTask.done() }
        let^tableTask = self^.tableTask
        if^tableTask != nil^ { return^tableTask.done() }
        let^mediaTask = self^.mediaTask
        if^mediaTask != nil^ { return^mediaTask.done() }
        return^false^
    },
    disposeTask = p^self^{
        let^scriptTask = self^.scriptTask
        if^scriptTask != nil^ { scriptTask.dispose() self^.scriptTask := nil^ }
        let^tableTask = self^.tableTask
        if^tableTask != nil^ { tableTask.dispose() self^.tableTask := nil^ }
        let^mediaTask = self^.mediaTask
        if^mediaTask != nil^ { mediaTask.dispose() self^.mediaTask := nil^ }
    },
    finish = p^self^{
        let^scriptTask = self^.scriptTask
        if^scriptTask != nil^ {
            let^result = try^std.task.await(scriptTask)
            if^!self^.batch.cancelled {
                if^result != nil^ {
                    scripts[self^.path] := result
                    tables[self^.path] := result.raw
                else^: self^.batch.error := $"{self^.path}: invalid script result"
                }
            }
            return^
        }
        let^tableTask = self^.tableTask
        if^tableTask != nil^ {
            let^result = try^std.task.await(tableTask)
            if^!self^.batch.cancelled {
                if^result != nil^ { tables[self^.path] := result
                else^: self^.batch.error := $"{self^.path}: invalid LTON result"
                }
            }
            return^
        }
        let^mediaTask = self^.mediaTask
        if^mediaTask != nil^ {
            let^error = try^std.task.await(mediaTask)
            if^!self^.batch.cancelled and^error != nil^ {
                self^.batch.error := $"{self^.path}: {error}"
            }
        }
    catch^:
        if^!self^.batch.cancelled { self^.batch.error := $"{self^.path}: {it^.message}" }
    },
}

var^queue : t^{Job[]} = {}
var^next = 0
var^active : t^{Job[]} = {}
var^started = false^
var^tables : t^{[string^]:t^{}|nil^} = {}
var^scripts : t^{[string^]:vp.scriptdata.Data|nil^} = {}
var^syncReads = 0
public^let^fallbackReads = f^{ syncReads }

# Callers use the media directory as a logical package key. Only metadata IO
# maps to data/; texture/audio paths and cache keys remain under assets/.
let^metadataPath = f^path:string^-> string^{
    if^path.substring(0, 6) = "assets/" { return^$"data/{path.substring(7)}" }
    return^path
}

public^let^data = p^path:string^-> t^{}|nil^{
    let^known = tables[path]
    if^known != nil^ { return^known }
    syncReads += 1
    let^raw = std.lton.load(metadataPath(path)) catch^nil^
    if^raw fits^t^{} { tables[path] := raw return^raw }
    return^nil^
}

public^let^script = p^path:string^-> vp.scriptdata.Data|nil^{
    let^known = scripts[path]
    if^known != nil^ { return^known }
    let^raw = data(path)
    if^raw is^nil^{ return^nil^ }
    let^parsed = vp.scriptdata.parse(raw)
    scripts[path] := parsed
    return^parsed
}

# Called once per rendered update. Never await an unfinished task. Bound
# both in-flight decoded memory and GPU uploads; a single upload can exceed
# the budget, but file reading and decoding cannot stall this thread.
public^let^pump = p^seconds:number^{
    # Requires the core's per-machine member caches (TechnicalDocuments/0029).
    if^!started { try^std.task.start(2) started := true^ }
    let^start = love.timer.getTime()
    var^kept : t^{Job[]} = {}
    for^j in^active {
        if^j.done() and^love.timer.getTime() - start < seconds {
            j.finish()
            let^ch = j.channel
            if^ch != nil^ {
                let^object = ch.pop()
                if^object fits^love.image.ImageData {
                    if^!j.batch.cancelled and^j.batch.error = "" {
                        let^tex = love.graphics.newImage(object)
                        tex.setFilter(love.graphics.FilterMode.nearest, love.graphics.FilterMode.nearest)
                        j.batch.arena.textures[j.path] := tex
                    }
                    object.dispose()
                elseif^object fits^love.audio.Source:
                    if^j.batch.cancelled or^j.batch.error != "" {
                        object.dispose()
                    else^:
                        j.batch.arena.sounds[j.path] := object
                        j.batch.arena.sources.push^(object)
                    }
                }
                ch.dispose()
            }
            j.disposeTask()
            j.batch.pending -= 1
        else^:
            kept.push^(j)
        }
    }
    active := kept
    repeat^while^active.length^ < 16 and^next < queue.length^ {
        let^maybe = queue[next]
        next += 1
        if^maybe != nil^ {
            let^j : Job = maybe
            if^j.batch.cancelled or^j.batch.error != "" { j.batch.pending -= 1
            else^:
                j.launch()
                if^j.hasTask() {
                    active.push^(j)
                else^:
                    j.batch.pending -= 1
                }
            }
        }
    }
    if^next >= queue.length^ {
        queue := {}
        next := 0
    }
catch^:
    panic^$"Async loading: {it^.message}"
}

public^let^stop = p^{
    if^started { std.task.stop() started := false^ }
    for^j in^active {
        let^ch = j.channel
        if^ch != nil^ {
            let^object = ch.pop()
            if^object fits^love.image.ImageData { object.dispose() }
            if^object fits^love.audio.Source { object.dispose() }
            ch.dispose()
        }
        j.disposeTask()
    }
    active := {}
    queue := {}
    next := 0
}

public^let^outstanding = f^{ active.length^ + queue.length^ - next }
