# The flow of a match, as FM2K's engine runs it with the system file's skills
# (TechnicalDocuments/0013). Each stage of a round is a system skill run for
# its show time (its Settings block); what it spawns (the VS screen, READY,
# FIGHT, KO, ...) are its objects, drawn in view coordinates by depth.
#
#   start   #13 round start (2)
#   call    #15.. round 1-9 / #24 final: round 1's is the VS screen (425)
#   ready   #25 READY ... FIGHT (230)
#   fight   the fighters are free; the clock runs
#   ko      #26 KO / time over (100); the loser falls (its #23 "loss")
#   win     #30 / #31 "1P / 2P WIN" or #32 draw; the winner's #22 "win"
#   end     #14 round end (150), then the next round or a new match
module^vp.round
import^love.audio

require^"fighter.lh"
require^"script.lh"
require^"hud.lh"

let^Fighter = vp.fighter.Fighter

# The system file's built-in skills (its KGTBuiltInSkills).
let^ROUND_START = 13
let^ROUND_END = 14
let^ROUND_1 = 15              # "round 1" .. "round 9": 15-23
let^ROUND_FINAL = 24
let^FIGHT = 25
let^KO = 26
let^PERFECT = 27
let^WIN_1P = 30
let^WIN_2P = 31
let^DRAW = 32
let^DOUBLE_KO = 33
let^HIT = 1                    # "HIT COMBO"
let^HIT_DIGIT = 2              # the hit count's digits 0-9: 2-11
let^MARK_ON = 55
let^MARK_OFF = 56
# "position: victory mark 1P / 2P" (76 / 77): the first mark and the step.
let^MARK_1P_X = 264
let^MARK_2P_X = 372
let^MARK_Y = 62
let^MARK_STEP = 20

# A hit count's tens digit sits this far left of its ones (a guess: the
# original was not measured past 3 hits; the digits are 30-35 wide).
let^DIGIT_STEP = 30

# A character's built-in skills used here.
let^VICTORY = 22
let^LOSS = 23

# Replay only the opaque portrait frames while the VS exit waits for assets.
# Keep the suspended entrance coroutine and its position intact for resume.
let^PortraitLoop = def^{
    self^{
        abstract^portrait : Fighter,
        frames : t^{t^{image:number^, time:number^}[]} = {},
        at = 0, left = 0, saved = -1,
    },
    override^new = f^portrait:Fighter{ self^{portrait = portrait} },
    step = p^self^{
        if^self^.frames.length^ = 0 { return^ }
        if^self^.saved < 0 { self^.saved := self^.portrait.image }
        if^self^.left <= 0 {
            let^frame = self^.frames[self^.at]
            if^frame != nil^ {
                self^.portrait.image := frame.image
                self^.left := frame.time
            }
            self^.at := (self^.at + 1) % self^.frames.length^
        }
        self^.left -= 1
    },
    resume = p^self^{
        if^self^.saved >= 0 { self^.portrait.image := self^.saved self^.saved := -1 }
    },
}

public^let^Round = def^{
    self^{
        dir = "",
        script : vp.script.Script|nil^= nil^,
        phase = "start",
        music : love.audio.Source|nil^= nil^,
        presentationFrames = 0,
        waitingFrames = 0,
        portraitLoops : t^{PortraitLoop[]} = {},
        externalPresentation = false^,
        battleRevealed = false^,
        preparing = false^,         # VS presentation may run before fighter assets arrive
        left = 0,                   # frames left of this stage
        number = 1,                 # the round
        toWin = 2,                  # rounds a side needs to win the match
        wins1 = 0, wins2 = 0,
        winner = 0,                 # 1, 2, or 0 for a draw
        perfect = false^,           # the winner took no damage
        layers : t^{Fighter[]} = {},    # the system skills running now
        portraits : t^{Fighter[]} = {},
        marks : t^{Fighter[]} = {},
        combos : t^{Fighter[]} = {},    # hit counts, in world coordinates
    },

    portrait = p^self^, name:string^, colour:number^, side:number^{
        let^dir = $"assets/characters/{name}"
        let^sc = vp.script.load($"{dir}/portrait.lton")
        if^sc is^nil^ { panic^$"Missing VS portrait: {name}" }
        let^raw = sc.raw
        if^raw fits^t^{versus:t^{entry:number^, leftX:number^, rightX:number^, y:number^}} {
            let^intro = raw.versus
            let^p = Fighter.new(dir, if^side = 0: intro.leftX el^: intro.rightX;, intro.y)
            sc.install(p)
            p.palette := colour
            p.facing := if^side = 0: 1 el^: -1;
            p.ground := 1000000
            p.begin(intro.entry)
            self^.portraits.push^(p)
            let^loop = PortraitLoop.new(p)
            let^skill = sc.byId[intro.entry]
            var^opaque = false^
            if^skill != nil^ {
                for^b in^skill.blocks {
                    if^b.op = "COLOR" { opaque := (b.n[0] ?? -1) = 0 }
                    if^opaque and^b.op = "I" {
                        loop.frames.push^({image = b.n[0] ?? -1, time = if^(b.n[1] ?? 0) > 0: b.n[1] ?? 1 el^: 1;})
                    }
                }
            }
            self^.portraitLoops.push^(loop)
        }
    },
    runAt = p^self^, n:number^, x:number^, y:number^-> Fighter {
        let^l = Fighter.new(self^.dir, x, y)
        let^sc = self^.script
        if^sc != nil^ { sc.install(l) }
        l.begin(n)
        l.ground := 1000000
        l.system := true^
        l.depth := 125                  # a round's own images: in front of the HUD
        return^l
    },
    # Stage `phase`: system skill n for its show time. The show time is when the
    # engine moves on; the skills already running go on until they end (FIGHT
    # clears the timer's hiding after its show time).
    enter = p^self^, phase:string^, n:number^{
        self^.phase := phase
        self^.layers.push^(self^.runAt(n, 0, 0))
        let^sc = self^.script
        self^.left := if^sc != nil^: sc.showTime(n) el^: 0;
    },
    # Restart every mark with the round: earned marks replay their entrance.
    placeMarks = p^self^{
        self^.marks := {}
        for^k from^0 to^self^.toWin - 1 {
            self^.marks.push^(self^.runAt(if^self^.wins1 > k: MARK_ON el^: MARK_OFF;, MARK_1P_X - MARK_STEP * k, MARK_Y))
            self^.marks.push^(self^.runAt(if^self^.wins2 > k: MARK_ON el^: MARK_OFF;, MARK_2P_X + MARK_STEP * k, MARK_Y))
        }
    },
    # Marks are interleaved 1P / 2P. Only the newly earned slot starts over;
    # all earlier marks keep their current animation and display state.
    awardMark = p^self^, side:number^, wins:number^{
        let^k = wins - 1
        let^x = if^side = 0: MARK_1P_X - MARK_STEP * k el^: MARK_2P_X + MARK_STEP * k;
        self^.marks[2 * k + side] := self^.runAt(MARK_ON, x, MARK_Y)
    },
    backgroundOnly = f^self^-> bool^{ self^.externalPresentation and^!self^.battleRevealed },
    fighting = f^self^-> bool^{
        return^self^.phase = "fight"
    },
    # #111 holds image 207 before spawning the closing wipe. Let its entrance
    # finish, then defer that exit only; portrait bitmap animation stays live.
    waitingForAssets = p^self^-> bool^{
        if^!self^.preparing or^self^.phase != "call" or^self^.presentationFrames < 100 { return^false^ }
        for^l in^self^.layers {
            for^o in^l.objects {
                if^o.skillNo = 111 and^o.depth = 105 and^o.image = 207 and^o.waitTimer <= 0 { return^true^ }
            }
        }
        return^false^
    },
    animateWaitingPortraits = p^self^{
        self^.waitingFrames += 1
        for^loop in^self^.portraitLoops { loop.step() }
    },
    # One frame. `timeUp`: the clock has run out. `reset` puts the fighters back
    # for the next round; `over` is called when a side has won the match.
    step = p^self^, p1:Fighter, p2:Fighter, timeUp:bool^, reset:p^;, over:p^;{
        if^self^.waitingForAssets() { self^.animateWaitingPortraits() return^ }
        for^loop in^self^.portraitLoops { loop.resume() }
        self^.presentationFrames += 1
        var^portraits : t^{Fighter[]} = {}
        for^p in^self^.portraits {
            # The original #21 -> #31 spawns these after 28 frames.
            if^self^.presentationFrames > 28 { p.step() }
            if^!p.finished() { portraits.push^(p) }
        }
        self^.portraits := portraits
        var^running : t^{Fighter[]} = {}
        for^l in^self^.layers {
            l.step()
            l.stepObjects()
            for^o in^l.objects {
                # #111 at depth 105 is the VS exit. Its opaque image 62
                # covers the entire viewport before the fade back to battle.
                if^o.skillNo = 111 and^o.depth = 105 and^o.image = 62 {
                    self^.battleRevealed := true^
                }
            }
            if^!(l.finished() and^l.objects.length^ = 0) { running.push^(l) }
        }
        self^.layers := running
        for^m in^self^.marks { m.step() }
        var^showing : t^{Fighter[]} = {}
        for^c in^self^.combos {
            c.step()
            if^!c.finished() { showing.push^(c) }
        }
        self^.combos := showing

        if^self^.phase = "fight" {
            let^down1 = p1.life <= 0
            let^down2 = p2.life <= 0
            if^!(down1 or^down2 or^timeUp) { return^}
            self^.winner := if^down1 and^down2: 0
                el^down2: 1
                el^down1: 2
                el^p1.life > p2.life: 1
                el^p2.life > p1.life: 2
                el^: 0;
            if^down1 { p1.begin(LOSS) }
            if^down2 { p2.begin(LOSS) }
            self^.enter("ko", if^down1 and^down2: DOUBLE_KO el^: KO;)
            self^.perfect := false^
            let^w = if^self^.winner = 1: p1 el^self^.winner = 2: p2 el^: nil^;
            if^w != nil^ { self^.perfect := w.life >= w.lifeMax }
            return^
        }

        if^self^.left > 0 {
            self^.left -= 1
            return^
        }
        if^self^.phase = "start" {
            let^call = if^self^.number <= 9: ROUND_1 + self^.number - 1 el^: ROUND_FINAL;
            self^.enter("call", call)
        elseif^self^.phase = "call":
            self^.enter("ready", FIGHT)
        elseif^self^.phase = "ready":
            self^.phase := "fight"
        elseif^self^.phase = "ko":
            if^self^.winner = 1 {
                self^.wins1 += 1
                self^.awardMark(0, self^.wins1)
                p1.begin(VICTORY)
                self^.enter("win", WIN_1P)
            elseif^self^.winner = 2:
                self^.wins2 += 1
                self^.awardMark(1, self^.wins2)
                p2.begin(VICTORY)
                self^.enter("win", WIN_2P)
            else^:
                self^.enter("win", DRAW)
            }
            # PERFECT shows with "1P / 2P WIN", not with KO (the original, VS mode)
            if^self^.perfect { self^.layers.push^(self^.runAt(PERFECT, 0, 0)) }
        elseif^self^.phase = "win":
            self^.enter("end", ROUND_END)
        elseif^self^.phase = "end":
            # #14 ends in black (its #112 fades out and stays); the new round
            # clears the system's objects and #13 fades in.
            if^self^.wins1 >= self^.toWin or^self^.wins2 >= self^.toWin {
                over()
                return^
            }
            self^.number += 1
            reset()
            self^.layers := {}
            self^.combos := {}
            self^.enter("start", ROUND_START)
            self^.placeMarks()
        }
    },
    # A combo's count (2 and up): the system's "HIT COMBO" and the count's digits,
    # at (x, y) in the world. Measured in the original (TechnicalDocuments/0018):
    # every hit from the second on spawns a fresh set, and the earlier ones play
    # out their own scripts.
    showCombo = p^self^, count:number^, x:number^, y:number^{
        let^add = p^n:number^, at:number^{
            let^c = self^.runAt(n, at, y)
            c.depth := 101
            self^.combos.push^(c)
        }
        add(HIT, x)
        var^rest = count.floor()
        var^at = x
        repeat^while^true^ {
            add(HIT_DIGIT + rest % 10, at)
            rest := (rest / 10).floor()
            at -= DIGIT_STEP
            if^rest = 0 { break^}
        }
    },
    items = p^self^-> t^{Item[]}{
        var^out : t^{Item[]} = {}
        let^add = p^f:Fighter, depth:number^{
            let^i = Item.new()
            i.depth := depth
            i.f := f
            i.system := true^
            out.push^(i)
        }
        for^m in^self^.marks { add(m, 100) }
        for^c in^self^.combos {
            add(c, c.depth)
            let^last = out[out.length^ - 1]
            if^last != nil^ { last.world := true^}
        }
        for^l in^self^.layers {
            add(l, l.depth)
            for^o in^l.objects { add(o, o.depth) }
        }
        for^p in^self^.portraits {
            let^i = Item.new()
            i.depth := 117
            i.f := p
            out.push^(i)
        }
        return^out
    },
}

public^let^load = p^dir:string^-> Round {
    let^r = Round.new()
    r.dir := dir
    r.script := vp.script.load($"{dir}/script.lton")
    r.enter("start", ROUND_START)
    r.placeMarks()
    return^r
}

# What to draw in view coordinates: the running system skills, their objects
# and the victory marks, with their depths (a skill itself sits at 125).
public^let^Item = def^{
    self^{
        depth = 0,
        f : Fighter|nil^= nil^,
        system = false^,            # a system image (top-left), else a character's
        world = false^,             # at a place in the world (hit counts), not the view
    },

    draw = p^self^{
        let^f = self^.f
        if^f is^nil^ { return^}
        if^self^.system { vp.hud.drawWhole(f) else^: f.draw() }
    },
}

# Sorts by depth, keeping the order of equal ones.
public^let^byDepth = p^list:t^{Item[]} {
    for^i from^1 to^list.length^ - 1 {
        let^x = list[i]
        if^x != nil^ {
            var^j = i - 1
            repeat^while^j >= 0 {
                let^y = list[j]
                if^y is^nil^ or^y.depth <= x.depth { break^}
                list[j + 1] := y
                j -= 1
            }
            list[j + 1] := x
        }
    }
}
