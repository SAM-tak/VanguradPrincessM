# A stage: its scripts run as layers (the same way a character's skills run,
# see TechnicalDocuments/0007) and are drawn back to front, with the players
# between them where the stage's プレーヤー位置 script stands.
module^vp.stage

import^love.graphics

require^"fighter.lh"
require^"sprite.lh"
require^"script.lh"

let^Fighter = vp.fighter.Fighter

# The view is 640x480 of the 1280x960 stage. A layer that scrolls at ratio s
# moves s px for each px the camera moves, and sits where its script puts it
# when the camera is at the stage's top-left. (The school's foreground is
# 1388 = 1280 + 640 * 0.16 wide at 116%, and 789 + 267 - 480 * 0.2 = 960 at 120%:
# made to fit exactly that way.)
let^VIEW_W = 640
let^VIEW_H = 480

public^let^Stage = def^{
    self^{
        layers : t^{Fighter[]} = {},
        players = 0,               # layers before this index are behind the players
    },

    step = p^self^{
        for^l in^self^.layers {
            l.step()
            l.stepObjects()   # what a layer spawns (O); none in the original's data
        }
    },
    # Layers [from, to).
    draw = p^self^, camX:number^, camY:number^, from:number^, to:number^{
        for^k, l in^self^.layers {
            if^k >= from and^k < to { drawLayer(l, camX, camY) }
        }
    },
}

# A converted stage folder: its script.lton, run as layers.
public^let^load = p^dir:string^-> Stage{
    let^st = Stage.new()
    let^maybe = vp.script.load($"{dir}/script.lton")
    if^maybe is^nil^ { return^st }
    let^sc : vp.script.Script = maybe
    sc.loops := true^              # its layers start over when they run off their end
    let^players = sc.playersLayer()
    for^n in^sc.layerIds() {
        let^l = Fighter.new(dir, 0, 0)
        sc.install(l)
        l.begin(n)
        l.ground := 1000000        # layers move freely; nothing lands
        if^n = players { st.players := st.layers.length^ }
        # Measured in the original (TechnicalDocuments/0015): the layers
        # before the players' marker are at depth 12, those from it on at 100.
        l.depth := if^n >= players and^players >= 0: 100 el^: 12;
        st.layers.push^(l)
    }
    return^st
}

# Draws one layer, in world coordinates (the caller has moved to the camera).
let^drawLayer = p^l:Fighter, camX:number^, camY:number^{
    if^!l.alive { return^}             # ended with E
    let^w, h = l.sheet.size(l.image)
    if^w = 0 { return^}
    var^x = l.x + l.ix + camX * (1 - l.scrollX)
    var^y = l.y + l.iy + camY * (1 - l.scrollY)
    var^countX = 1
    var^countY = 1
    if^l.loopX {
        x := camX - ((camX - x) % w + w) % w
        countX := (VIEW_W / w).ceil() + 1
    }
    if^l.loopY {
        y := camY - ((camY - y) % h + h) % h
        countY := (VIEW_H / h).ceil() + 1
    }
    # turnX / turnY mirror the image in place (瓦礫's light rays, #13, come
    # from the top-left so; they were drawn as stored, from the top-right).
    let^sx = if^l.turnX: -1 el^: 1;
    let^sy = if^l.turnY: -1 el^: 1;
    vp.sprite.setBlend(l.blend, l.alpha)
    for^i from^0 to^countX - 1 {
        for^j from^0 to^countY - 1 {
            # Sheet.draw takes the bottom-centre; stage images are placed by their top-left.
            l.sheet.draw(l.image, x + i * w + (w / 2).floor(), y + j * h + h, 0, sx, sy, l.tintR, l.tintG, l.tintB)
        }
    }
    vp.sprite.resetBlend()
}
