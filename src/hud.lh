# The game's own HUD, from the system (.kgt) file's skills: the frame layouts
# and the life / special gauges, drawn in view (640x480) coordinates.
# Each character's own part (support gauge, stun, hit count, ...) comes from
# its start skill's objects instead. See TechnicalDocuments/0010.
module^vp.hud

import^love.graphics

require^"fighter.lh"
require^"sprite.lh"
require^"script.lh"

let^Fighter = vp.fighter.Fighter

# The system file's built-in skill numbers (its KGTBuiltInSkills).
let^LAYOUTS : t^{number^[]} = { 57, 58, 59, 60, 61, 62, 63, 64, 65, 66 }
let^LAYOUT_TIME = 61          # layout 5: the big "60" / "70" / "80" / "∞" through a round's start
let^LIFE_1P = 67
let^LIFE_2P = 68
let^SPECIAL_1P = 69
let^SPECIAL_2P = 70
let^STOCK_NUMBER_0 = 45        # "special stock number 0".."9": 45-54
let^STOCK_1P_X = 12            # the "position: special stock" skills (74 / 75)
let^STOCK_2P_X = 627
let^STOCK_Y = 476
let^TIMER_INFINITE = 34        # "timer number ∞"
let^TIMER_NUMBER_0 = 35        # "timer number 0".."9": 35-44
let^TIMER_X = 320              # "position: timer" (71): centre, digit spacing 35
let^TIMER_Y = 65
let^TIMER_SPACING = 35

public^let^Hud = def^{
    self^{
        layers : t^{Fighter[]} = {},
        life1 : Fighter|nil^= nil^,
        life2 : Fighter|nil^= nil^,
        special1 : Fighter|nil^= nil^,
        special2 : Fighter|nil^= nil^,
        dir = "",
        # The special stock numbers: each side's number skill, restarted when
        # its stock count changes.
        stock1 : Fighter|nil^= nil^,
        stock2 : Fighter|nil^= nil^,
        shown1 = -1, shown2 = -1,
        # The timer: a number skill per digit, restarted when its digit
        # changes (under 8 seconds the ones digit flashes and beeps).
        tens : Fighter|nil^= nil^,
        ones : Fighter|nil^= nil^,
        shownSeconds = -2,
    },

    # A round starts the HUD's skills over (layout 5, the big "60", times itself
    # by the round: 699 frames in round 1, 349 after).
    restart = p^self^{
        self^.layers := {}
        for^n in^LAYOUTS { self^.layers.push^(run(self^.dir, n)) }
        self^.life1 := run(self^.dir, LIFE_1P)
        self^.life2 := run(self^.dir, LIFE_2P)
        self^.special1 := run(self^.dir, SPECIAL_1P)
        self^.special2 := run(self^.dir, SPECIAL_2P)
        self^.shown1 := -1
        self^.shown2 := -1
        self^.shownSeconds := -2
    },
    # The clock starts: layout 5's big "60" goes (it outlasts the round's start
    # by some frames and showed under "59") and the timer's digits start over
    # (started hidden, they would look again only hundreds of frames later).
    fightBegins = p^self^{
        for^l in^self^.layers {
            if^l.skillNo = LAYOUT_TIME { l.alive := false^ }
        }
        self^.shownSeconds := -2
    },
    each = p^self^-> t^{Fighter[]} {
        var^all : t^{Fighter[]} = {}
        for^l in^self^.layers { all.push^(l) }
        for^l in^{ self^.life1, self^.life2, self^.special1, self^.special2, self^.stock1, self^.stock2, self^.tens, self^.ones } {
            if^l fits^Fighter { all.push^(l) }
        }
        return^all
    },
    # The timer's digits for `seconds` left (negative: no time limit, "∞").
    stepTimer = p^self^, seconds:number^{
        if^seconds = self^.shownSeconds { return^}
        let^before = self^.shownSeconds
        self^.shownSeconds := seconds
        if^seconds < 0 {
            self^.tens := runAt(self^.dir, TIMER_INFINITE, TIMER_X, TIMER_Y)
            self^.ones := nil^
            return^
        }
        let^s = seconds.clamp(0, 99)
        let^tens = (s / 10).floor()
        let^ones = s % 10
        let^half = TIMER_SPACING / 2
        if^before < 0 or^tens != (before / 10).floor() {
            self^.tens := runAt(self^.dir, TIMER_NUMBER_0 + tens, TIMER_X - half, TIMER_Y)
        }
        if^before < 0 or^ones != before % 10 {
            self^.ones := runAt(self^.dir, TIMER_NUMBER_0 + ones, TIMER_X + half, TIMER_Y)
        }
    },
    step = p^self^, p1:Fighter, p2:Fighter, seconds:number^{
        self^.stepTimer(seconds)
        let^n1 = stocks(p1)
        if^n1 != self^.shown1 {
            self^.shown1 := n1
            self^.stock1 := runAt(self^.dir, STOCK_NUMBER_0 + n1, STOCK_1P_X, STOCK_Y)
        }
        let^n2 = stocks(p2)
        if^n2 != self^.shown2 {
            self^.shown2 := n2
            self^.stock2 := runAt(self^.dir, STOCK_NUMBER_0 + n2, STOCK_2P_X, STOCK_Y)
        }
        for^l in^self^.each() { l.step() }
    },
    # Draws the HUD in view coordinates (call it with the view's transform).
    draw = p^self^, p1:Fighter, p2:Fighter{
        for^l in^self^.layers { drawWhole(l) }
        drawGauge(self^.life1, p1.life / p1.lifeMax, true^)
        drawGauge(self^.life2, p2.life / p2.lifeMax, true^)
        drawGauge(self^.special1, stockFraction(p1), false^)
        drawGauge(self^.special2, stockFraction(p2), false^)
        for^l in^{ self^.stock1, self^.stock2, self^.tens, self^.ones } {
            if^l fits^Fighter { drawWhole(l) }
        }
    },
}

var^script = vp.script.Script.new()     # the system file's skills

let^runAt = p^dir:string^, n:number^, x:number^, y:number^-> Fighter {
    let^l = Fighter.new(dir, x, y)
    script.install(l)
    l.begin(n)
    l.ground := 1000000
    l.system := true^
    return^l
}

let^run = p^dir:string^, n:number^-> Fighter{
    return^runAt(dir, n, 0, 0)
}

public^let^load = p^dir:string^-> Hud {
    let^h = Hud.new()
    h.dir := dir
    script := vp.script.load($"{dir}/script.lton") ?? vp.script.Script.new()
    h.restart()
    return^h
}

# A side's stock count, as the number skill to show (0-9).
let^stocks = f^p:Fighter-> number^{
    return^(p.special / p.specialPer).floor().clamp(0, 9)
}

# A layout layer's image at its script position (top-left), as it is.
public^let^drawWhole = p^l:Fighter {
    if^!l.alive { return^}             # ended with E
    let^w, h = l.sheet.size(l.image)
    if^w = 0 { return^}
    vp.sprite.setBlend(l.blend, l.alpha)
    l.sheet.drawPart(l.image, l.x + l.ix, l.y + l.iy, 0, w, l.turnX, l.tintR, l.tintG, l.tintB)
    vp.sprite.resetBlend()
}

# A gauge's image cut to `fraction` of its width. `fromEnd`: the part kept is
# the end of the image (the side towards the middle of the screen for the 1P
# life gauge); a mirrored (turnX) gauge keeps the mirrored side.
let^drawGauge = p^l:Fighter|nil^, fraction:number^, fromEnd:bool^{
    if^!(l fits^Fighter) { return^}
    let^w, h = l.sheet.size(l.image)
    if^w = 0 { return^}
    let^kept = (w * fraction.clamp(0, 1)).floor()
    let^from = if^fromEnd: w - kept el^: 0;
    vp.sprite.setBlend(l.blend, l.alpha)
    l.sheet.drawPart(l.image, l.x + l.ix, l.y + l.iy, from, kept, l.turnX, l.tintR, l.tintG, l.tintB)
    vp.sprite.resetBlend()
}

# The fraction of the current stock that is filled.
let^stockFraction = f^p:Fighter-> number^{
    if^p.special >= p.specialPer * p.stockMax: 1
    el^:(p.special % p.specialPer) / p.specialPer;
}
