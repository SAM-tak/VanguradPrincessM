# Run through tools/test-async.ps1 so assets resolve from the game root.
module^vp.asyncflowtest
import^love.keyboard
import^love.event
import^love.timer
require^"../main.lh"
require^"../src/arena.lh"
require^"../src/resource.lh"
var^phase = 0
var^frames = 0
var^wait = 0
var^began = 0
var^worst = 0
var^attacked = false^
var^supportAttacked = false^
var^pauseTime = 0
var^pauseX = 0
var^pauseLife = 0
var^failure : vp.resource.Batch|nil^= nil^
var^fadeChecked = false^
var^introSeen = false^
var^revealed = false^
var^introLeft = 425

let^press = p^key:love.keyboard.Key {
    vp.main.keypressed(key, love.keyboard.Scancode.unknown, false^)
}

public^let^load = p^{
    began := love.timer.getTime()
    vp.main.load()
}

public^let^update = p^dt:number^{
    let^start = love.timer.getTime()
    vp.main.update(0.02) # two simulation ticks per test step, even at high refresh rates
    let^spent = love.timer.getTime() - start
    if^spent > worst { worst := spent }
    frames += 1
    let^where = vp.arena.names()
    let^state = vp.main.status()
    if^phase = 14 and^!revealed and^!state.backgroundOnly {
        if^state.introCatchup != 0 or^state.presentationFrames < 220 { panic^"Battle revealed before entrants and transition were ready" }
        print($"VS reveal frame={state.presentationFrames} opponentX={state.enemyX}")
        revealed := true^
    }
    if^vp.main.status().duplicatePortraits != 0 { panic^"Character replayed the VS portrait" }
    if^vp.main.status().phase = "match-intro" {
        if^!vp.main.status().stagePrepared { panic^"VS started before stage preparation" }
        if^!vp.main.status().introMusicPlaying or^vp.main.status().introPortraits != 2 { panic^"VS portraits or music missing during load" }
        introSeen := true^
        if^vp.main.status().roundFrames != 6000 { panic^"Timer advanced during VS loading" }
        if^vp.main.status().roundPhase = "call" { introLeft := vp.main.status().presentationLeft }
    }
    if^phase = 3 and^where = "system / title" {
        let^fade = vp.main.status().modeExitFrames
        if^fade >= 0 and^fade < 50 {
            if^vp.resource.outstanding() != 0 { panic^"Select loading began before mode fade completed" }
            if^!fadeChecked {
                if^!vp.main.status().modeCuePlaying { panic^"Mode confirmation sound did not play" }
                fadeChecked := true^
            }
        }
    }
    if^phase = 3 and^where = "system / select" {
        if^!fadeChecked { panic^"Mode fade was skipped" }
    }
    if^where = "system / select" and^vp.main.status().selectCuePlayed { panic^"Select opening coin cue still plays" }
    if^phase = 0 and^where = "system / opening" { print($"boot frames={frames}") press(love.keyboard.Key.z) phase := 1
    elseif^phase = 1: press(love.keyboard.Key.z) phase := 2
    elseif^phase = 2 and^where = "system / title": press(love.keyboard.Key.down) press(love.keyboard.Key.z) phase := 3
    elseif^phase = 3 and^where = "system / select": print($"select frames={frames}") press(love.keyboard.Key.z) phase := 4
    elseif^phase = 4: press(love.keyboard.Key.j) phase := 5
    elseif^phase = 5: press(love.keyboard.Key.l) phase := 6
    elseif^phase = 6 and^vp.main.status().phase = "match-intro" and^vp.resource.outstanding() > 0:
        wait += 1
        if^wait >= 5 {
            let^before = vp.arena.names()
            press(love.keyboard.Key.escape)
            if^vp.arena.names() != before or^vp.main.status().phase != "match-intro" or^vp.main.status().paused { panic^"ESC affected loading" }
            press(love.keyboard.Key.f8)
            if^vp.main.status().paused or^vp.arena.names() != "system / opening" { panic^"F8 failed during loading" }
            phase := 7
        }
    elseif^phase = 7 and^where = "system / opening": press(love.keyboard.Key.z) phase := 9
    elseif^phase = 9 and^where = "system / title": press(love.keyboard.Key.down) press(love.keyboard.Key.z) phase := 10
    elseif^phase = 10 and^where = "system / select": press(love.keyboard.Key.z) phase := 11
    elseif^phase = 11: press(love.keyboard.Key.j) phase := 12
    elseif^phase = 12: introSeen := false^ introLeft := 425 press(love.keyboard.Key.l) phase := 13
    elseif^phase = 13 and^where = "system / select / match" and^vp.main.status().phase = "battle":
        if^!vp.main.status().matchMusicPlaying { panic^"BGM stopped at match adoption" }
        if^!introSeen { panic^"Match loaded without showing VS presentation" }
        if^vp.main.status().roundPhase = "call" and^vp.main.status().presentationLeft > introLeft { panic^"VS presentation restarted after load" }
        print($"match frames={frames} elapsed={love.timer.getTime() - began} worst={worst}")
        wait := 0
        phase := 14
    elseif^phase = 14:
        wait += 1
        if^wait > 200 and^wait < 400 and^wait % 17 = 0 { press(love.keyboard.Key.a) }
        let^support = vp.main.status().supportSkill
        if^support >= 10476 and^support <= 10506 { supportAttacked := true^ }
        if^wait = 450 {
            press(love.keyboard.Key.escape)
            let^s = vp.main.status()
            if^!s.paused { panic^"ESC did not pause battle" }
            pauseTime := s.roundFrames
            pauseX := s.enemyX
            pauseLife := s.enemyLife
        }
        if^wait > 450 and^wait <= 470 {
            let^s = vp.main.status()
            if^!s.paused or^s.roundFrames != pauseTime or^s.enemyX != pauseX or^s.enemyLife != pauseLife { panic^"battle advanced during pause" }
            press(love.keyboard.Key.f2)
            press(love.keyboard.Key.z)
        }
        if^wait = 470 {
            press(love.keyboard.Key.return)
            if^vp.main.status().paused { panic^"Start/Return did not resume battle" }
        }
        if^wait = 480 and^vp.main.status().roundFrames >= pauseTime { panic^"battle did not resume" }
        if^wait > 200 and^wait % 30 = 0 { press(love.keyboard.Key.l) }
        if^wait > 200 and^vp.main.status().enemySkill >= 200 { attacked := true^ }
        if^wait = 300 { press(love.keyboard.Key.k) }
        if^wait = 301 and^vp.main.status().enemyLife <= 1 { panic^"2P right key still changes life" }
        if^wait > 600 {
            if^!revealed { panic^"Battle never became visible" }
            if^!attacked { panic^"2P attack input was not executed" }
            if^!supportAttacked { panic^"D did not start a support attack during live battle" }
            if^vp.resource.fallbackReads() != 0 or^vp.arena.fallbacks() != 0 { panic^$"synchronous fallback: lton={vp.resource.fallbackReads()} assets={vp.arena.fallbacks()}" }
            let^b = vp.resource.Batch.new("missing-file-test")
            failure := b
            b.request("assets/does-not-exist.png", "image", false^)
            phase := 15
        }
    elseif^phase >= 15 and^phase <= 18:
        let^b = failure
        if^b != nil^ and^b.error != "" {
            b.cancel()
            if^vp.resource.outstanding() = 0 {
                if^phase = 15 {
                    let^missing = vp.resource.Batch.new("missing-script-test")
                    missing.request("assets/does-not-exist.lton", "script", false^)
                    failure := missing
                    phase := 16
                elseif^phase = 16:
                    let^missing = vp.resource.Batch.new("missing-table-test")
                    missing.request("assets/does-not-exist.lton", "lton", false^)
                    failure := missing
                    phase := 17
                elseif^phase = 17:
                    let^missing = vp.resource.Batch.new("missing-sound-test")
                    missing.request("assets/does-not-exist.wav", "sound", false^)
                    failure := missing
                    phase := 18
                else^:
                    press(love.keyboard.Key.escape)
                    if^!vp.main.status().paused { panic^"Pause setup failed" }
                    press(love.keyboard.Key.f8)
                    if^vp.main.status().paused or^vp.arena.names() != "system / opening" { panic^"F8 failed from pause" }
                    if^vp.main.status().battleResourcesHeld { panic^"F8 retained battle resources" }
                    vp.main.update(0.02)
                    if^vp.resource.cachedScripts() != 1 { panic^"F8 retained battle definitions" }
                    print($"PASS: F8 from loading and pause, loading ignores ESC, two fighters, D support attack, pause/freeze/resume, battle drawing, missing image, sound, typed table and script; frames={frames}; synchronous fallback reads=0")
                    love.event.quit()
                }
            }
        }
    }
    if^love.timer.getTime() - began > 120 { panic^$"timeout phase={phase} arena={where}" }
}

public^let^draw = p^{ vp.main.draw() }

public^let^quit = p^-> bool^{ return^vp.main.quit() }
