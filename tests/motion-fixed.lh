module^vp.motionfixedtest
import^love.event
require^"../src/fighter.lh"
let^equal = p^got:number^, want:number^{ if^got != want { panic^$"M: {got}, expected {want}" } }
let^bit = f^mask:number^, value:number^-> bool^{ (mask / value).floor() % 2 = 1 }
public^let^load = p^{
 let^f = vp.fighter.Fighter.new("",0,0)
 for^side in^{1,-1} { for^mask from^0 to^31 {
  var^flags = if^bit(mask,1): "add" el^: "";
  if^bit(mask,2) { flags := $"{flags} keepVX" }
  if^bit(mask,4) { flags := $"{flags} keepVY" }
  if^bit(mask,8) { flags := $"{flags} keepAX" }
  if^bit(mask,16) { flags := $"{flags} keepAY" }
  f.facing := side
  f.vx := 101/65536 f.vy := -103/65536 f.ax := 107/65536 f.ay := -109/65536
  f.motion(-32768,32767,-32768,32767,flags)
  let^add = bit(mask,1)
  equal(f.vx*65536,if^bit(mask,2):101 el^: -32768*655*side + (if^add:101 el^:0;);)
  equal(f.vy*65536,if^bit(mask,4):-103 el^: 32767*655 + (if^add:-103 el^:0;);)
  equal(f.ax*65536,if^bit(mask,8):107 el^: -32768*393*side + (if^add:107 el^:0;);)
  equal(f.ay*65536,if^bit(mask,16):-109 el^: 32767*393 + (if^add:-109 el^:0;);)
 } }
 f.facing := 1 f.motion(65535,32768,65536,-32769,"")
 equal(f.vx*65536,-655) equal(f.vy*65536,-32768*655)
 equal(f.ax,0) equal(f.ay*65536,32767*393)
 f.vx := 32767 f.vy := -32768 f.ax := 32767 f.ay := -32768
 f.motion(200,-200,200,-200,"add")
 equal(f.vx*65536,32767*65536+200*655-4294967296)
 equal(f.vy*65536,-32768*65536-200*655+4294967296)
 equal(f.ax*65536,32767*65536+200*393-4294967296)
 equal(f.ay*65536,-32768*65536-200*393+4294967296)
 f.x := 0 f.y := 0 f.ground := 10000
 f.minX := -30000 f.maxX := 30000 f.minXAir := -30000 f.maxXAir := 30000
 f.motion(3,-7,1,-1,"")
 var^x = 0 var^y = 0 var^vx = 3*655 var^vy = -7*655
 for^i from^1 to^200 {
  vx += 393 vy -= 393 x += vx y += vy
  f.moveStep()
  equal(f.vx*65536,vx) equal(f.vy*65536,vy)
  equal(f.x*65536,x) equal(f.y*65536,y)
 }
 print("PASS: M signed words, both facings, all 32 flag combinations, 32-bit add overflow, exact fractional trajectory")
 love.event.quit()
}
public^let^draw = p^{}
