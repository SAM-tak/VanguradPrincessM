# Every portrait introduction, all difficulty positions, and loading cancellation.
module^vp.storynavigation

import^love.keyboard
import^love.event
import^love.timer
require^"../main.lh"
require^"../src/arena.lh"
require^"../src/resource.lh"

var^phase = 0
var^row = 0
var^moved = 0
var^wait = 0
var^began = 0

let^press = p^key:love.keyboard.Key {
    vp.main.keypressed(key, love.keyboard.Scancode.unknown, false^)
}

public^let^load = p^{
    began := love.timer.getTime()
    vp.main.load()
}

public^let^update = p^dt:number^{
    vp.main.update(0.02)
    let^s = vp.main.status()
    let^where = vp.arena.names()
    if^phase = 0 and^where = "system / opening" { press(love.keyboard.Key.z) phase := 1
    elseif^phase = 1: press(love.keyboard.Key.z) phase := 2
    elseif^phase = 2 and^where = "system / title": press(love.keyboard.Key.z) phase := 3
    elseif^phase = 3 and^s.phase = "select":
        wait += 1
        if^wait > 30 {
            if^moved < row { press(love.keyboard.Key.down) moved += 1
            else^: press(love.keyboard.Key.z) phase := 4 wait := 0 }
        }
    elseif^phase = 4 and^s.phase = "difficulty":
        wait += 1
        if^wait = 10 {
            if^row % 3 = 0 { press(love.keyboard.Key.left) }
            if^row % 3 = 2 { press(love.keyboard.Key.right) }
        }
        if^wait > 30 {
            if^s.difficulty != row % 3 { panic^"difficulty selection" }
            press(love.keyboard.Key.z) phase := 5 wait := 0
        }
    elseif^phase = 5 and^s.phase = "intro":
        wait += 1
        if^wait > 30 {
            print($"intro row={row}, difficulty={s.difficulty}")
            if^row = 9 { press(love.keyboard.Key.z) phase := 8
            else^: press(love.keyboard.Key.escape) phase := 6 }
            wait := 0
        }
    elseif^phase = 6 and^s.phase = "difficulty": press(love.keyboard.Key.escape) phase := 7
    elseif^phase = 7 and^s.phase = "select":
        row += 1 moved := 0 wait := 0 phase := 3
    elseif^phase = 8 and^s.phase = "match-intro":
        press(love.keyboard.Key.escape)
        if^vp.main.status().phase != "match-intro" or^vp.main.status().paused { panic^"ESC affected story loading" }
        phase := 9
    elseif^phase = 9 and^s.phase = "battle" and^vp.resource.outstanding() = 0:
        if^vp.resource.fallbackReads() != 0 or^vp.arena.fallbacks() != 0 { panic^"synchronous fallback" }
        print("PASS: all 10 introductions, 3 difficulties, ESC navigation, loading ignores ESC")
        love.event.quit()
    }
    if^love.timer.getTime() - began > 120 { panic^$"timeout row={row} phase={phase}" }
}

public^let^draw = p^{ vp.main.draw() }

public^let^quit = p^-> bool^{ return^vp.main.quit() }
