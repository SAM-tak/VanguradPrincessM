module^vp.commandmodestest
import^love.event
require^"../src/preload.lh"
require^"../src/resource.lh"
require^"../src/fighter.lh"
require^"../src/script.lh"
let^Fighter = vp.fighter.Fighter
let^loadout = vp.preload.Load.new("command-modes")
var^done = false^
public^let^load = p^{
    loadout.add("assets/characters/ゆい", false^)
    loadout.add("assets/characters/はるか", false^)
}
let^actor = p^-> Fighter {
    let^f = Fighter.new("assets/characters/ゆい", 500, 920)
    f.ground := 920
    return^f
}
let^run = p^{
    let^window = actor()
    for^i from^1 to^1200 { window.record(5, 0) }
    if^window.entered(65, {0}, {1}, {0}, {1}) or^window.command(65, {0}, {1}) { panic^"Empty history matched" }
    window.record(5, 1)
    for^i from^1 to^4 { window.record(5, 0) }
    if^!window.entered(5, {0}, {1}, {0}, {1}) or^!window.command(5, {0}, {1}) { panic^"Prefilter discarded buffered edge" }
    window.record(5, 0)
    if^window.entered(5, {0}, {1}, {0}, {1}) or^window.command(5, {0}, {1}) { panic^"Expired input survived" }
    if^!window.entered(1, {0}, {0}, {0}, {1}) { panic^"Prefilter rejected direction-only command" }
    window.record(5, 7)
    for^mask in^{1, 2, 3, 4, 5, 6, 7} {
        if^!window.entered(1, {0}, {mask}, {0}, {1}) or^!window.command(1, {0}, {mask}) { panic^"Simultaneous press subset lost" }
    }
    window.record(5, 1) window.record(5, 2)
    if^window.entered(2, {0}, {3}, {0}, {1}) { panic^"Separate presses became simultaneous" }
    for^i from^1 to^1024 { window.record(5, 0) }
    if^window.command(1024, {0}, {7}) { panic^"Wrapped history reused stale press" }
    # Exhaust all requested masks and predecessor masks, for both scanners.
    let^edges = actor()
    for^previous from^0 to^63 { for^need from^1 to^63 {
        edges.recordHeld(5, previous)
        edges.recordHeld(5, need)
        var^overlap = false^
        var^bit = 1
        repeat^while^bit <= 32 {
            if^(previous / bit).floor() % 2 = 1 and^(need / bit).floor() % 2 = 1 { overlap := true^ }
            bit *= 2
        }
        if^edges.entered(1, {0}, {need}, {0}, {1}) = overlap or^edges.command(1, {0}, {need}) = overlap {
            panic^"Native button edge mismatch"
        }
    } }
    edges.recordHeld(5, 0) edges.recordHeld(5, 3) edges.recordHeld(5, 3)
    if^edges.command(1, {0}, {3}) or^!edges.command(2, {0}, {3}) { panic^"Held/buffered simultaneous input" }
    let^object = actor() object.owner := edges
    if^!object.command(2, {0}, {3}) { panic^"Object did not read owner input" }
    for^time in^{29, 30} {
        let^history = actor()
        history.addCommand("consume", time, 0, 0, 0, 0, {0}, {2}, {0}, {1})
        for^i from^1 to^1050 { history.record(5, 0) }
        history.record(6, 1)
        for^i from^1 to^20 { history.record(5, 0) }
        history.record(5, 2)
        if^!history.command(30, {0}, {1}) { panic^"COM consumed history" }
        history.fromCommands(false^)
        if^history.command(30, {0}, {1}) != (time = 29) { panic^"History consumption threshold or unavailable skill" }
        if^!history.command(1, {0}, {2}) { panic^"Latest press consumed" }
        if^history.command(30, {2}, {0}) != (time = 29) { panic^"Consumed direction survived" }
        if^time = 30 {
            for^i from^1 to^1030 { history.record(5, 0) }
            history.record(6, 1)
            for^i from^1 to^20 { history.record(5, 0) }
            history.record(5, 2) history.fromCommands(false^)
            if^history.command(30, {0}, {1}) { panic^"Consumption after ring wrap" }
        }
    }
    let^boundary = actor()
    boundary.record(5, 1)
    for^i from^1 to^20 { boundary.record(5, 1) }
    if^boundary.command(20, {0}, {1}) { panic^"Held edge appeared before consumption" }
    boundary.consumeCommandHistory()
    if^!boundary.command(20, {0}, {1}) or^boundary.command(19, {0}, {1}) { panic^"Oldest surviving sample must follow neutral" }
    boundary.consumeCommandHistory()
    if^!boundary.command(20, {0}, {1}) { panic^"Repeated consumption changed boundary" }
    boundary.record(5, 1) boundary.consumeCommandHistory()
    if^!boundary.command(20, {0}, {1}) { panic^"Sliding consumed boundary" }
    let^ordered : t^{t^{number^[]}[]} = {{6, 2, 4, 8}, {6, 8, 4, 2}, {8, 4, 2, 6}, {2, 4, 8, 6}}
    for^sequence in^ordered {
        let^rotation = actor()
        for^d in^sequence { rotation.record(d, 0) }
        if^!rotation.entered(10, {0}, {0}, {3}, {1}) { panic^"Ordered rotation rejected" }
        if^rotation.entered(10, {0}, {0}, {3}, {2}) { panic^"One rotation counted as two" }
    }
    let^invalid : t^{t^{number^[]}[]} = {{6, 4, 2, 8}, {9, 3, 1, 7}, {6, 2, 4}}
    for^sequence in^invalid {
        let^rotation = actor()
        for^d in^sequence { rotation.record(d, 0) }
        if^rotation.entered(10, {0}, {0}, {3}, {1}) { panic^"Unordered/diagonal/incomplete rotation accepted" }
    }
    let^twice = actor()
    for^d in^{6, 2, 4, 8, 6, 2, 4, 8} { twice.record(d, 0) }
    if^!twice.entered(8, {0}, {0}, {3}, {2}) or^twice.entered(7, {0}, {0}, {3}, {2}) { panic^"Two-rotation window boundary" }
    # VP records facing-relative directions; turning must not rewrite history.
    for^side in^{1, -1} {
        let^turn = actor() turn.facing := side
        turn.record(2, 0) turn.record(3, 0)
        turn.facing := -side
        turn.record(6, 1)
        if^!turn.entered(3, {4, 3, 2}, {0, 0, 1}, {0, 0, 0}, {1, 1, 1}) or^!turn.command(3, {4, 3, 2}, {0, 0, 1}) {
            panic^"Facing change reinterpreted earlier relative input"
        }
        if^turn.command(3, {4, 5, 2}, {0, 0, 1}) { panic^"Past down-forward became down-back" }
        let^object = actor() object.owner := turn object.facing := side
        if^!object.command(3, {4, 3, 2}, {0, 0, 1}) { panic^"Object facing changed owner history" }
        let^chargeTurn = actor() chargeTurn.facing := side
        chargeTurn.record(4, 1) chargeTurn.facing := -side
        chargeTurn.record(4, 1) chargeTurn.record(4, 1)
        if^!chargeTurn.entered(1, {6}, {1}, {2}, {3}) { panic^"Relative charge lost across turn" }
    }
    let^f = actor() let^enemy = actor()
    let^sc = vp.script.load("assets/characters/ゆい/script.lton")
    if^sc is^nil^ { panic^"Missing Yui" }
    sc.install(f)
    if^f.closeRange != 126 { panic^"Missing interval" }
    f.commands := {}
    f.addCommand("near/far", 1, 13, 11, 12, 14, {0}, {1}, {0}, {1})
    f.enemy := enemy
    for^side in^{-1, 1} { for^distance in^{125, 126, 126.9, 127} {
        enemy.x := f.x + side * distance
        f.record(5, 0) f.record(5, 1)
        let^want = if^distance < 127: 11 el^: 12;
        if^f.fromCommands(false^) != want or^f.fromCommands(true^) != 14 { panic^"Range boundary/crouch selection" }
        f.y := 900
        if^f.fromCommands(false^) != 13 { panic^"Air selection" }
        f.y := 920
    } }
    f.enemy := nil^
    if^f.fromCommands(false^) != 12 { panic^"No target must use far" }
    let^c = f.commands[0]
    if^c is^nil^ { panic^"Missing command" }
    c.far := 0
    if^f.fromCommands(false^) != 0 { panic^"Unavailable far must not use near" }
    let^r = actor()
    r.recordHeld(5, 7)
    if^r.entered(15, {0}, {7}, {1}, {5}) { panic^"Repeat accepted one press" }
    for^i from^1 to^6 { r.recordHeld(5, 7) }
    if^r.entered(15, {0}, {7}, {1}, {5}) { panic^"Holding counted as repeated press" }
    r.recordHeld(5, 0) r.recordHeld(5, 7)
    if^!r.entered(15, {0}, {7}, {1}, {5}) { panic^"Repeat did not consume four units per press" }
    let^partial = actor()
    partial.recordHeld(5, 7) partial.recordHeld(5, 1) partial.recordHeld(5, 7)
    if^partial.entered(15, {0}, {7}, {1}, {5}) { panic^"Repeat accepted partial release" }
    let^charge = actor()
    charge.recordHeld(4, 1) charge.recordHeld(4, 1)
    if^charge.entered(1, {6}, {1}, {2}, {3}) { panic^"Charge too short" }
    charge.recordHeld(4, 1)
    if^!charge.entered(1, {6}, {1}, {2}, {3}) { panic^"Charge history must extend beyond search window" }
    charge.recordHeld(4, 0)
    if^charge.entered(1, {6}, {1}, {2}, {3}) { panic^"Released button counted as charge" }
    let^haruka = vp.script.load("assets/characters/はるか/script.lton")
    if^haruka is^nil^ { panic^"Missing Haruka" }
    let^h = actor() haruka.install(h)
    for^command in^h.commands {
        if^command.name = "cpu" { h.commands := { command } break^ }
    }
    h.recordHeld(5, 7)
    if^h.fromCommands(false^) = 262 { panic^"Haruka cpu command accepted one press" }
    h.recordHeld(5, 0) h.recordHeld(5, 7)
    if^h.fromCommands(false^) != 262 { panic^"Haruka real repeat command" }
    print("PASS: 4032 native button transitions, history consumption/boundary/wrap, buffered edges and owner COM; near/far inclusive/truncated distance, posture/missing target, repeat release/amount, charge duration, real Haruka command")
}
public^let^update = p^dt:number^{
    vp.resource.pump(0.006)
    if^!done and^loadout.ready() { done := true^ run() love.event.quit() }
}
public^let^draw = p^{}
public^let^quit = p^-> bool^{ vp.resource.stop() return^false^ }
