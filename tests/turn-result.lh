module^vp.turnresulttest
import^love.event
require^"../src/fighter.lh"
require^"../src/script.lh"
require^"../src/round.lh"
require^"../src/resource.lh"
let^Fighter = vp.fighter.Fighter
public^let^load = p^{
 let^sc = vp.script.loadFor("assets/characters/ゆい/script.lton",101)
 let^system = vp.script.load("assets/system/ヴァンガードプリンセス/script.lton")
 if^sc is^nil^ or^system is^nil^ { panic^"Missing scripts" }
 for^side in^{1,-1} {
  let^p = Fighter.new("assets/characters/ゆい",640,920)
  let^e = Fighter.new(p.dir,640-side*100,920)
  sc.install(p) sc.install(e) p.enemy := e e.enemy := p p.facing := side
  p.y := 900 p.vy := 1 p.begin(7) p.stepScript()
  p.faceOpponent()
  if^p.facing != side { panic^"Turned in the air" }
  p.y := 920 p.stepScript()
  if^p.skillNo != 9 { panic^"Missing real landing event" }
  p.recordHeld(5,1)
  for^tick from^0 to^8 { if^!p.finished() { p.recordHeld(5,0) p.stepScript() } }
  if^!p.finished() { panic^"Landing did not finish" }
  p.faceOpponent()
  if^p.facing != -side { panic^"Landing recovery did not turn before command" }
  if^!p.takeCommand(false^) { panic^"Buffered A was lost" }
  p.stepScript()
  e.x := p.x + side*100 p.faceOpponent()
  if^p.facing != -side { panic^"Turned a running attack" }
 }
 print("PASS: real jump landing, both crossover directions, buffered A, active attack facing")
 for^side in^{1,-1} {
  let^p = Fighter.new("assets/characters/ゆい",640,900)
  let^e = Fighter.new(p.dir,640-side*100,920)
  sc.install(p) p.enemy := e p.facing := side p.ground := 920 p.vy := 8
  p.begin(232) p.stepScript()
  p.y := 921 p.stepScript()
  if^p.skillNo != 10 or^p.finished() { panic^"Missing active air-C landing recovery" }
  p.recordHeld(5,4) p.faceOpponent()
  if^!p.takeCommand(false^) or^p.skillNo != 224 { panic^"Missing landing C" }
  if^p.facing != -side { panic^"Air C -> landing -> ground C still faces away" }
 }
 print("PASS: video path #232 -> active #10 -> #224, both directions")
 for^side in^{1,-1} {
  let^p = Fighter.new("assets/characters/ゆい",640,900)
  let^e = Fighter.new(p.dir,640-side*100,920)
  sc.install(p) p.enemy := e p.facing := side p.ground := 920 p.vy := 8
  p.begin(7) p.stepScript()
  p.y := 921 p.vy := 8
  p.recordHeld(5,4) p.faceOpponent()
  if^p.mayStart(224) or^p.takeCommand(false^) { panic^"Ground command bypassed pending landing" }
  p.stepScript()
  if^p.skillNo != 9 { panic^"Landing DS was lost" }
  for^tick from^0 to^8 { if^!p.finished() { p.recordHeld(5,0) p.stepScript() } }
  p.faceOpponent()
  if^!p.takeCommand(false^) or^p.skillNo != 224 or^p.facing != -side { panic^"Landing boundary lost buffered C or facing" }
 }
 print("PASS: input before landing DS cannot erase it, buffered C retained, both directions")
 for^winner in^{1,2} {
  vp.fighter.clearSystemVars()
  let^a = Fighter.new("assets/characters/ゆい",500,920)
  let^d = Fighter.new(a.dir,700,920)
  sc.install(a) sc.install(d) a.enemy := d d.enemy := a d.facing := -1
  a.special := 1500 a.begin(292) a.stepScript() d.life := 0
  let^attacking = a.skillNo
  let^flow = vp.round.Round.new() flow.script := system flow.phase := "fight"
  let^p1 = if^winner = 1: a el^: d;
  let^p2 = if^winner = 1: d el^: a;
  flow.step(p1,p2,false^,p^{},p^{})
  if^flow.phase != "ko" or^d.skillNo != 23 or^a.skillNo != attacking { panic^"KO replaced attacker" }
  flow.left := 0
  flow.step(p1,p2,false^,p^{},p^{})
  if^flow.phase != "ko" or^a.skillNo != attacking { panic^"KO interrupted super" }
  var^advanced = false^
  for^tick from^0 to^500 {
   let^ready = a.readyForResult()
   let^before = a.skillNo
   flow.step(p1,p2,false^,p^{ advanced := true^ },p^{ advanced := true^ })
   if^before != 22 and^a.skillNo = 22 and^!ready { panic^"Premature victory" }
   if^advanced { break^ }
   a.step() d.step() a.stepObjects() d.stepObjects()
   if^a.finished() and^a.airborne() { a.start(7,0) }
  }
  if^!advanced { panic^"Result timeline stalled" }
  let^b = vp.fighter.Box.new(0,0,10,10)
  if^a.canHit(b,d) { panic^"Dead fighter can be hit again" }
 }
 print("PASS: real super runs through KO, both winners, bounded result wait, dead target excluded")
 let^luna = vp.script.loadFor("assets/characters/ルナ/script.lton",101)
 if^luna is^nil^ { panic^"Missing Luna" }
 for^winner in^{1,2} {
  for^lastRound in^{false^,true^} {
   vp.fighter.clearSystemVars()
   let^a = Fighter.new("assets/characters/ルナ",500,920)
   let^d = Fighter.new("assets/characters/ゆい",700,920)
   luna.install(a) sc.install(d) a.enemy := d d.enemy := a
   a.begin(235)
   for^tick from^0 to^200 { a.step() }
   if^a.skillNo != 234 or^a.readyForResult() { panic^"Luna did not enter looping stance" }
   d.life := 0
   let^flow = vp.round.Round.new() flow.script := system flow.phase := "fight"
   flow.toWin := if^lastRound: 1 el^: 2;
   let^p1 = if^winner = 1: a el^: d;
   let^p2 = if^winner = 1: d el^: a;
   var^resets = 0 var^overs = 0
   flow.step(p1,p2,false^,p^{ resets += 1 },p^{ overs += 1 })
   let^budget = 300 + system.showTime(14) + 1
   for^tick from^1 to^budget {
    # Model a non-terminating stance even after the Luna KO patch.
    a.setv(138,0)
    a.step() d.step()
    flow.step(p1,p2,false^,p^{ resets += 1 },p^{ overs += 1 })
    if^a.skillNo != 234 { panic^"Stance was forcibly replaced" }
    if^tick = 299 and^flow.phase != "ko" { panic^"Stance wait ended early" }
    if^tick = 300 and^flow.phase != "end" { panic^"Three-second deadline missed" }
    if^tick < budget and^(resets + overs) != 0 { panic^"Ended before configured show times" }
   }
   if^(lastRound and^(overs != 1 or^resets != 0)) or^(!lastRound and^(resets != 1 or^overs != 0)) { panic^"Stance blocked round/match completion" }
   if^flow.wins1 != (if^winner = 1: 1 el^: 0;) or^flow.wins2 != (if^winner = 2: 1 el^: 0;) { panic^"Incorrect victory count" }

  }
 }
 print("PASS: Luna stance preserved, three-second deadline, both winners, next round and match end, one award")
 for^winner in^{1,2} {
  let^a = Fighter.new("assets/characters/ゆい",500,920)
  let^d = Fighter.new(a.dir,700,920)
  sc.install(a) sc.install(d)
  let^flow = vp.round.Round.new() flow.script := system flow.phase := "ko"
  flow.winner := winner flow.resultFrames := 280
  flow.step(a,d,false^,p^{},p^{})
  if^flow.phase != "win" { panic^"Ready fighter failed to start victory" }
  for^tick from^282 to^300 { flow.step(a,d,false^,p^{},p^{}) }
  if^flow.phase != "end" or^flow.resultFrames != 300 { panic^"Win phase reset the KO deadline" }
  if^flow.wins1 + flow.wins2 != 1 { panic^"Win timeout awarded twice" }
 }
 print("PASS: delayed victory shares KO deadline and never awards twice")
 love.event.quit()
}
public^let^draw = p^{}
public^let^quit = p^-> bool^{ vp.resource.stop() return^false^ }
