# Shared support loading and real HUD COM execution for every owner and input.
module^vp.supportflowtest
import^love.event
import^love.timer
require^"../src/preload.lh"
require^"../src/script.lh"
require^"../src/scriptdata.lh"
require^"../src/fighter.lh"
require^"../src/resource.lh"
require^"../src/cpu.lh"

let^NAMES = {"ゆい", "はるか", "リリス", "ルナ", "くるみ", "サキ", "かえで", "カテジナ", "えり", "あやね"}
let^HUDS = {"さぽーとふぇいす2ｐ", "しえらコマンド", "ぱーとなーふぇいす", "ヨメふぇいす", "おまけふぇいす"}
let^DISPATCHERS = {"攻撃分岐", "攻撃ヴんき", "パートナー分岐", "ヨメ攻撃分岐", "オマケ分岐"}
let^ENTRIES = {
    "オプ飛び道具", "昇竜本体", "急降下", "キック本体", "オプガード",
    "サポート弱攻撃", "爆撃", "リフレクター本体", "待機", "サポガード",
    "弱攻撃本体", "グラビディ", "グルグル", "ぱーとなー強攻撃", "パートナーガード",
    "ヨメ弱攻撃", "犬発射", "落とし穴", "幽霊発動", "ヨメガード",
    "蝶発射", "オマケレーザー", "命令2", "オマケ命令", "オマケガード",
}
let^DIRS = {5, 2, 3, 6, 4}
let^REQUESTS = {101, 150, 130, 110, 102}
let^loadout = vp.preload.Load.new("support-test")
var^began = 0
var^owner = 0

public^let^load = p^{
    began := love.timer.getTime()
    loadout.add("assets/characters/ゆい", false^)
    loadout.add("assets/characters/くるみ", false^)
    loadout.character("assets/characters/ヒルダ", 100)
    loadout.batch.request("assets/characters/ゆい/cpu.lton", "lton", false^)
    for^name in^NAMES {
        loadout.batch.request($"assets/characters/{name}/script.lton", "script", false^)
        for^support in^{"えこ", "シエラ", "ジュリエット", "かなえ", "ヒルダ"} {
            loadout.batch.request($"assets/supports/{support}/{name}.lton", "script", false^)
        }
    }
}

let^check = p^name:string^{
    let^dir = $"assets/characters/{name}"
    let^sc = vp.script.load($"{dir}/script.lton")
    if^sc is^nil^ { panic^$"Missing character {name}" }
    for^hi, hud in^HUDS {
        var^skill = -1
        var^first = -1
        var^dispatch = -1
        for^n:number^, sk:vp.scriptdata.Skill in^sc.byId {
            if^sk.name = DISPATCHERS[hi] { dispatch := n }
            if^sk.name = hud {
                skill := n
                if^sk.media != dir { panic^"Support media still belongs to owner" }
                for^i, b in^sk.blocks {
                    if^b.op = "COM" and^first < 0 { first := i }
                }
            }
        }
        if^skill < 0 or^first < 0 or^dispatch < 0 { panic^$"Missing HUD {name}/{hud}" }
        for^i, direction in^DIRS {
            let^p = vp.fighter.Fighter.new(dir, 100, 0)
            let^other = vp.fighter.Fighter.new(dir, 400, 0)
            sc.install(p)
            p.vars[71] := 100
            p.vars[76] := 0
            p.record(direction, 8)
            # Opposite-side input must not feed this object's command checks.
            other.record(5, 1)
            let^object = p.makeObject(skill, first, 0, 0, 100)
            if^i % 2 = 1 { p.record(direction, 0) }
            object.step()
            let^actual = p.v(76)
            if^actual != REQUESTS[i] { panic^$"{name}/{hud}/{direction}D: request={actual}" }
            let^actor = p.makeObject(dispatch, 0, 0, 0, 80)
            actor.advance()
            let^target = sc.byId[actor.jumpSkill]
            if^target is^nil^ or^target.name != ENTRIES[hi * 5 + i] { panic^$"Wrong attack entry: {name}/{hud}/{direction}D" }
            p.record(direction, 0)
            if^!object.command(20, {0}, {8}) { panic^"COM incorrectly consumed input" }
            for^frame from^1 to^20 { p.record(direction, 0) }
            if^object.command(20, {0}, {8}) { panic^"COM accepted expired input" }
            if^name = "くるみ" and^i = 0 {
                p.vars[76] := 93
                let^extra = p.makeObject(dispatch, 0, 0, 0, 80)
                extra.advance()
                if^hi < 4 {
                    let^target = sc.byId[extra.jumpSkill]
                    let^expected = if^hi = 3: "ソレトナクディフェンス立ち飛び" el^: "kyougiriえこ用";
                    if^target is^nil^ or^target.name != expected { panic^"Kurumi collaboration hook lost" }
                elseif^extra.jumpSkill >= 0:
                    panic^"Hilda gained an unexpected collaboration hook"
                }
            }
        }
    }
    print($"PASS: {name}: 25 support inputs and attack dispatches")
}

let^effects = p^{
    let^dir = "assets/characters/ゆい"
    let^sc = vp.script.load($"{dir}/script.lton")
    if^sc is^nil^ { panic^"Missing support effect script" }
    for^base in^{1, -1} {
        for^travel in^{1, -1} {
            let^p = vp.fighter.Fighter.new(dir, if^travel = 1: 680 el^: 520;, 920)
            sc.install(p)
            p.facing := base
            p.enemy := vp.fighter.Fighter.new(dir, if^travel = 1: 300 el^: 900;, 920)
            p.setv(70, if^base = 1: 100 el^: 200;)
            p.setv(78, 5600)
            let^actor = p.makeObject(if^travel = 1: 20526 el^: 20527;, 0, 600, 920, 69)
            p.slots[5] := actor
            p.stepObjects()
            let^drawFace = (if^actor.fixed: 1 el^: actor.facing;) * (if^actor.turnX: -1 el^: 1;)
            if^actor.vx * travel <= 0 or^drawFace != travel { panic^"Support did not face its movement" }
            for^i from^0 to^80 { p.stepObjects() }
            let^idleFace = actor.facing * (if^actor.turnX: -1 el^: 1;)
            if^actor.vx != 0 or^idleFace != -travel { panic^$"Support idle facing: base={base} travel={travel} face={idleFace}" }
            let^enemy = p.enemy
            if^enemy != nil^ { enemy.x := if^travel = 1: 900 el^: 300; }
            for^i from^0 to^100 { p.stepObjects() }
            if^actor.facing * (if^actor.turnX: -1 el^: 1;) != travel { panic^"Support did not turn after sides swapped" }
        }
        for^skill in^{20534, 20535} {
            let^p = vp.fighter.Fighter.new(dir, 640, 920)
            sc.install(p)
            p.facing := base
            let^shell = p.makeObject(skill, 0, 640, 800, 80)
            var^bounced = false^
            var^fell = false^
            for^i from^0 to^250 {
                p.stepObjects()
                if^shell.skillNo = 20536 { bounced := true^ }
                if^shell.y > shell.ground { fell := true^ }
            }
            if^!bounced or^!fell or^shell.alive { panic^"Shell must bounce, fall below floor, then expire" }
            if^p.objects[0] != nil^ { panic^"Expired shell remained in object list" }
        }
    }
    print("PASS: support movement / idle / side swap in both orientations; shell bounce and cleanup")
}

let^cpuAndBoss = p^{
    let^sc = vp.script.load("assets/characters/ゆい/script.lton")
    let^boss = vp.script.load("assets/characters/ヒルダ/script.lton")
    if^sc is^nil^ or^boss is^nil^ { panic^"Missing support test scripts" }
    for^hi, hud in^HUDS {
        for^side in^{1, -1} {
            let^p = vp.fighter.Fighter.new("assets/characters/ゆい", 600, 920)
            let^enemy = vp.fighter.Fighter.new("assets/characters/ゆい", 1000, 920)
            sc.install(p)
            p.facing := side
            p.enemy := enemy
            p.setv(71, 100)
            p.slots[5] := p.makeObject((hi + 1) * 10000 + ({452, 509, 575, 627, 688}[hi] ?? 0), 0, 600, 920, 69)
            var^controller : vp.fighter.Fighter|nil^= nil^
            for^n:number^, sk:vp.scriptdata.Skill in^sc.byId {
                if^sk.name = hud {
                    for^i, b in^sk.blocks {
                        if^b.op = "COM" and^controller is^nil^ { controller := p.makeObject(n, i, 0, 0, 100) }
                    }
                }
            }
            if^controller is^nil^ { panic^"Missing support controller" }
            let^cpu = vp.cpu.Brain.new("ゆい", 100)
            cpu.supportCooldown := 0
            let^input = cpu.step(p, enemy)
            if^input.buttons != 8 or^input.dir != 6 { panic^"CPU did not issue distant support input" }
            p.record(input.dir, input.buttons)
            controller.step()
            # Kanae's HUD delegates resource handling to the spawned attack.
            if^p.v(76) != 110 or^(hi != 3 and^p.v(71) >= 100) { panic^$"CPU D: {hud} side={side} request={p.v(76)} gauge={p.v(71)}" }
            if^cpu.step(p, enemy).buttons != 0 { panic^"CPU repeated support every frame" }
            cpu.supportCooldown := 0
            p.setv(76, 0)
            p.setv(71, 0)
            if^cpu.step(p, enemy).buttons != 0 { panic^"CPU requested support with empty gauge" }
        }
    }
    for^selected from^101 to^105 {
        let^p = vp.fighter.Fighter.new("assets/characters/ヒルダ", 600, 920)
        boss.install(p)
        p.setv(73, selected)
        let^actor = p.makeObject(451, 0, 600, 920, 69)
        for^i from^0 to^5 { actor.step() }
        if^actor.skillNo < 688 or^actor.skillNo > 709 { panic^"Boss did not use fixed original support" }
        p.setv(76, 110)
        actor.start(709, 0)
        for^i from^0 to^20 { actor.step() }
        if^actor.skillNo != 710 { panic^"Boss lost its dedicated attack" }
        for^o in^p.objects {
            if^o.skillNo >= 10000 { panic^"Boss spawned selectable shared support" }
        }
    }
    print("PASS: both CPU sides use all five support HUDs with gauge costs; boss ignores selectable support")
}

public^let^update = p^dt:number^{
    vp.resource.pump(0.006)
    if^loadout.ready() {
        let^name = NAMES[owner]
        if^name != nil^ {
            check(name)
            owner += 1
        else^:
            effects()
            cpuAndBoss()
            if^vp.resource.fallbackReads() != 0 { panic^"Synchronous script fallback" }
            print("PASS: 250 regular support inputs, fixed boss, CPU support; no synchronous metadata reads")
            love.event.quit()
        }
    }
    if^love.timer.getTime() - began > 120 { panic^"Support test timeout" }
}

public^let^draw = p^{}
public^let^quit = p^-> bool^{ vp.resource.stop() return^false^ }
