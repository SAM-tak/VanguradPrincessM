# Actual FA sequences plus guard reactions and EB execution.
module^vp.combatflowtest
import^love.event
import^love.timer
import^std.math
require^"../src/preload.lh"
require^"../src/resource.lh"
require^"../src/script.lh"
require^"../src/scriptdata.lh"
require^"../src/fighter.lh"
require^"../src/shake.lh"
require^"../src/cpu.lh"
require^"../src/round.lh"

let^Fighter = vp.fighter.Fighter
let^loadout = vp.preload.Load.new("combat-test")
var^began = 0
var^done = false^

public^let^load = p^{
    began := love.timer.getTime()
    loadout.add("assets/characters/カテジナ", false^)
    loadout.add("assets/characters/ゆい", false^)
    loadout.add("assets/characters/はるか", false^)
    loadout.add("assets/characters/えり", false^)
    loadout.add("assets/system/ヴァンガードプリンセス", false^)
}

# Isolate FA lifetime from movement, hitstop, invincibility and effect objects.
# The real script still advances its images, branches, FA updates and clears.
let^attack = p^dir:string^, name:string^, expected:number^, damage:number^{
    let^sc = vp.script.load($"{dir}/script.lton")
    if^sc is^nil^ { panic^"Missing attack script" }
    var^number = -1
    for^n:number^, sk:vp.scriptdata.Skill in^sc.byId { if^sk.name = name { number := n } }
    if^number < 0 { panic^$"Missing skill {name}" }
    let^p = Fighter.new(dir, 100, 0)
    let^def = Fighter.new(dir, 100, 0)
    sc.install(p)
    p.begin(number)
    var^hits = 0
    for^frame from^0 to^180 {
        p.step()
        let^box = p.hits[0]
        if^box != nil^ and^p.canHit(box, def) {
            p.struck(box, def, 100, false^, "") p.finishHitEvents()
            hits += 1
        }
    }
    if^hits != expected or^1000 - def.life != damage {
        panic^$"{name}: hits={hits} damage={1000 - def.life}; expected {expected}/{damage}"
    }
    # A fresh use must regain its hit allowance.
    p.begin(number)
    for^frame from^0 to^80 {
        p.step()
        let^box = p.hits[0]
        if^box != nil^ and^p.canHit(box, def) {
            p.struck(box, def, 100, false^, "") p.finishHitEvents()
            hits += 1
            break^
        }
    }
    if^hits != expected + 1 { panic^"New move did not reset its hit allowance" }
    print($"PASS: {name}: {expected} hits, {damage} damage; fresh use can hit")
}

let^guard = p^{
    let^dir = "assets/characters/ゆい"
    let^p = Fighter.new(dir, 100, 0)
    let^def = Fighter.new(dir, 110, 0)
    def.skills[9001] := p^f:Fighter, at:number^{ yield^ }
    def.reactHit[1] := 9001
    def.reactHit[2] := 9001
    def.updateGuard(true^, false^, true^)
    p.reactions(1, 1, 1, 2, 2, 2)
    for^hit from^0 to^2 {
        p.fa(0, 0, 0, 10, 10, 100, "combo")
        let^box = p.hits[0]
        if^box is^nil^ or^!p.canHit(box, def) { panic^"Explicit next hit was suppressed" }
        let^blocked, spark = p.struck(box, def, 100, false^, "") p.finishHitEvents()
        if^!blocked or^def.life != 1000 { panic^"Held guard failed during blockstun" }
        if^p.canHit(box, def) { panic^"Persistent multi-hit box connected twice" }
        def.updateGuard(true^, false^, false^)
    }
    # CPU direction must survive hitstop and blockstun too.
    let^brain = vp.cpu.Brain.new("ゆい", 100)
    def.record(1, 0)
    def.stop := 8
    let^input = brain.step(def, p)
    if^input.dir != 1 or^!input.guard { panic^"CPU released guard during hitstop" }
    def.stop := 0
    if^!brain.step(def, p).guard { panic^"CPU released guard during blockstun" }
    # A low must still break a standing guard, and block when down-back is held.
    p.reactions(1, 1, 1, 1, 2, 2)
    def.updateGuard(true^, true^, false^)
    p.fa(0, 0, 0, 10, 10, 100, "combo")
    let^low = p.hits[0]
    if^low is^nil^ { panic^"Missing low" }
    let^lowGuarded, spark = p.struck(low, def, 100, false^, "") p.finishHitEvents()
    if^!lowGuarded { panic^"Crouch guard posture was lost in blockstun" }
    def.updateGuard(true^, false^, false^)
    p.fa(0, 0, 0, 10, 10, 100, "combo")
    let^next = p.hits[0]
    if^next is^nil^ { panic^"Missing low" }
    let^standing, spark2 = p.struck(next, def, 100, false^, "") p.finishHitEvents()
    if^standing or^def.blocking or^def.life != 900 { panic^"Low did not break standing guard" }
    def.updateGuard(true^, false^, false^)
    if^def.guarding { panic^"Hitstun incorrectly allows guard" }
    def.blocking := true^
    def.updateGuard(false^, true^, false^)
    if^def.guarding { panic^"Released guard remains active" }
    def.begin(9001)
    if^def.blocking { panic^"New action retained blockstun" }
    # Two simultaneous boxes form one hit, even with Cont.Hits on both.
    p.fa(0, 0, 0, 10, 10, 10, "combo")
    p.fa(1, 0, 0, 10, 10, 10, "combo")
    let^a = p.hits[0]
    let^b = p.hits[1]
    if^a is^nil^ or^b is^nil^ { panic^"Missing grouped boxes" }
    p.struck(a, def, 100, false^, "") p.finishHitEvents()
    if^p.canHit(b, def) { panic^"Overlapping group hit twice" }
    p.hit(0, 0, 0, 20, 10, 10)
    let^updated = p.hits[0]
    if^updated is^nil^ or^p.canHit(updated, def) { panic^"Geometry update rearmed a normal attack" }
    p.noHit(0)
    p.hit(0, 0, 0, 30, 10, 10)
    let^restored = p.hits[0]
    if^restored is^nil^ or^p.canHit(restored, def) { panic^"FA clear erased the attack hit history" }
    p.noHit(0)
    p.noHit(1)
    p.hit(0, 0, 0, 30, 10, 10)
    let^newGroup = p.hits[0]
    if^newGroup is^nil^ or^!p.canHit(newGroup, def) { panic^"Empty FA group did not release its hit allowance" }
    if^!p.hitConfirmed { panic^"Ending FA group erased C hit-confirm" }
    p.on("attacking", 9001, 0)
    p.struck(newGroup, def, 100, false^, "") p.finishHitEvents()
    if^p.jumpSkill != 9001 { panic^"Late DS handler did not fire" }
    p.jumpSkill := -1
    p.landed(newGroup)
    if^p.jumpSkill != -1 { panic^"Consumed DS handler fired twice" }
    print("PASS: continuous guard, low/standing guard, release, CPU hold, hitstun, grouped boxes")
}

# Melt Shot's late FA groups allow new contact, but exclude existing hitstun.
let^melt = p^{
    let^sc = vp.script.load("assets/characters/はるか/script.lton")
    let^victimScript = vp.script.load("assets/characters/ゆい/script.lton")
    if^sc is^nil^ or^victimScript is^nil^ { panic^"Missing Melt Shot scripts" }
    let^owner = Fighter.new("assets/characters/はるか", 100, 0)
    let^def = Fighter.new("assets/characters/ゆい", 350, 0)
    sc.install(owner)
    victimScript.install(def)
    owner.enemy := def
    def.enemy := owner
    let^beam = owner.makeObject(227, 0, 193, -200, 127)
    var^hits = 0
    var^excluded = 0
    var^damage = 0
    for^frame from^0 to^90 {
        beam.step()
        def.step()
        if^def.finished() { def.begin(1) }
        let^box = beam.hits[0]
        if^box != nil^ {
            if^beam.canHit(box, def) {
                let^before = def.life
                beam.struck(box, def, 100, false^, "") beam.finishHitEvents()
                damage += before - def.life
                hits += 1
            elseif^!box.connected and^box.flags.find("duringReceipt") != nil^ and^def.receiving:
                excluded += 1
            }
        }
    }
    if^hits != 1 or^damage != 231 or^excluded = 0 {
        panic^$"Melt Shot: hits={hits}, life={def.life}, excluded={excluded}"
    }
    # A late part can still catch an opponent who missed the initial blast.
    def.damageHits := 0
    let^late = owner.makeObject(227, 34, 193, -200, 127)
    late.advance()
    let^box = late.hits[0]
    if^box is^nil^ { panic^"Missing late beam box" }
    # Landing now clears the main actor's hit-reaction bit as in FM2K.
    # Establish an active reaction instead of assuming it survives 90 frames.
    def.beginReaction(138) def.receiving := true^
    if^late.canHit(box, def) { panic^"Late beam hit a stunned target" }
    def.start(138, 0)
    if^!def.receiving { panic^"Script jump discarded hitstun" }
    def.begin(1)
    if^def.receiving or^!late.canHit(box, def) { panic^"Late beam cannot hit a recovered target" }
    late.reactions(47, 47, 47, 96, 97, 98)
    let^before = def.life
    late.struck(box, def, 100, false^, "") late.finishHitEvents()
    if^before - def.life != 131 { panic^"Late beam lost its own damage" }
    # State filters are independent of the attack's consumed-hit history.
    let^probe = vp.fighter.Box.new(0, 0, 10, 10)
    probe.flags := "combo noSkyDetection"
    def.receiving := false^
    def.blocking := true^
    if^late.canHit(probe, def) { panic^"No-blockstun FA hit a blocking target" }
    def.blocking := false^
    if^!late.canHit(probe, def) { panic^"No-blockstun FA rejected a free target" }
    probe.flags := "combo noDetection"
    def.y := def.ground
    if^late.canHit(probe, def) { panic^"Air-only FA hit a grounded target" }
    def.y -= 10
    if^!late.canHit(probe, def) { panic^"Air-only FA rejected an airborne target" }
    probe.flags := "combo duringGuard"
    if^late.canHit(probe, def) { panic^"Ground-only FA hit an airborne target" }
    def.y := def.ground
    if^!late.canHit(probe, def) { panic^"Ground-only FA rejected a grounded target" }
    print("PASS: Melt Shot projectile: one hit / 231 damage; late contact and FA target filters")
}

# Run the whole super, including its SG continuation and late DS hit branch.
# Contact is forced to isolate event/group lifetime from spacing and pushboxes.
let^yuiSuper = p^{
    let^dir = "assets/characters/ゆい"
    let^sc = vp.script.load($"{dir}/script.lton")
    if^sc is^nil^ { panic^"Missing Yui super" }
    let^p = Fighter.new(dir, 100, 0)
    let^def = Fighter.new(dir, 200, 0)
    sc.install(p)
    sc.install(def)
    p.enemy := def
    def.enemy := p
    p.special := 1500
    def.life := 100000
    def.begin(1)
    p.begin(292)
    var^hits = 0
    var^finisher = false^
    for^frame from^0 to^650 {
        p.step()
        def.step()
        if^def.finished() { def.begin(1) }
        let^box = p.hits[0]
        if^box != nil^ and^p.canHit(box, def) {
            p.struck(box, def, 100, false^, "") p.finishHitEvents()
            hits += 1
            print($"super contact {hits}: skill={p.skillNo} power={box.power}")
            if^p.skillNo = 236 and^box.power = 255 { finisher := true^ }
        }
    }
    if^hits != 10 or^!finisher { panic^$"Yui super: hits={hits}, finisher={finisher}" }
    print("PASS: Yui super: eight rush hits, late DS trigger, tenth-hit finisher")
}

let^landingAndPush = p^{
    let^dir = "assets/characters/ゆい"
    let^sc = vp.script.load($"{dir}/script.lton")
    if^sc is^nil^ { panic^"Missing landing data" }
    var^cases = 0
    for^face in^{-1, 1} {
        for^delay from^0 to^65 {
            for^stop in^{0, 3} {
                let^p = Fighter.new(dir, 500, 0)
                sc.install(p)
                p.facing := face
                p.begin(5)
                for^frame from^0 to^delay { p.step() }
                if^p.airborne() {
                    p.begin(216)
                    p.stop := stop
                    var^landed = false^
                    for^frame from^0 to^250 {
                        p.step()
                        if^p.y > p.ground + 0.001 { panic^"Air A sank below the floor" }
                        if^!p.airborne() and^(p.skillNo = 8 or^p.skillNo = 9 or^p.skillNo = 10) { landed := true^ }
                        if^p.finished() and^p.airborne() { p.start(7, 0) }
                    }
                    if^!landed { panic^$"Air A failed landing: face={face} delay={delay} stop={stop} y={p.y} skill={p.skillNo}" }
                    cases += 1
                }
            }
        }
    }
    let^a = Fighter.new(dir, 100, 0)
    let^b = Fighter.new(dir, 130, -30)
    b.ground := 0
    a.body(0, 0, -50, 25, 50)
    b.body(0, 0, -50, 25, 50)
    b.receiving := true^
    a.pushAgainst(b)
    if^a.x != 100 or^b.x != 150 { panic^"Air hitstun target passed through pushbox" }
    a.x := 100 b.x := 130 b.y := -200
    a.pushAgainst(b)
    if^a.x != 100 or^b.x != 130 { panic^"High jump cannot clear pushbox" }
    b.y := -30 b.x := 140 b.maxXAir := 140 a.x := 110
    a.pushAgainst(b)
    if^a.x != 90 or^b.x != 140 { panic^"Wall-bound air target still overlaps" }
    b.noHurt(0) a.x := 130
    a.pushAgainst(b)
    if^a.x != 130 { panic^"Missing pushbox still blocks movement" }
    b.hurt(0, 0, -50, 25, 50)
    a.pushAgainst(b)
    if^a.x != 130 { panic^"Hurt-only box incorrectly pushes" }
    b.body(0, 0, -50, 0, 50)
    a.pushAgainst(b)
    if^a.x != 130 { panic^"Zero-width pushbox still blocks movement" }
    b.body(0, 0, -50, 25, 50)
    a.x := 100 b.x := 130 b.maxXAir := 1000000
    b.pushAgainst(a)
    if^a.x != 100 or^b.x != 150 { panic^"Push depends on player update order" }
    print($"PASS: {cases} diagonal jump A landing cases; low-air push, high jump, wall, no-box")
}

let^sweepSuper = p^{
    let^dir = "assets/characters/ゆい"
    let^sc = vp.script.load($"{dir}/script.lton")
    if^sc is^nil^ { panic^"Missing sweep data" }
    let^p = Fighter.new(dir, 370, 920)
    let^def = Fighter.new(dir, 480, 920)
    sc.install(p) sc.install(def)
    p.enemy := def def.enemy := p
    def.facing := -1
    p.special := 1500 def.life := 100000
    for^f in^{p, def} { f.minX := 50 f.maxX := 1230 f.minXAir := 50 f.maxXAir := 1230 }
    p.begin(239) def.begin(1)
    var^startSuper = false^
    var^hits = 0
    var^finisher = false^
    for^frame from^0 to^750 {
        p.step() def.step()
        if^startSuper { p.begin(292) startSuper := false^ }
        p.stepObjects() def.stepObjects()
        if^def.finished() { if^def.airborne() { def.start(7, 0) else^: def.begin(1) } }
        var^contact = false^
        for^slot, box in^p.hits {
            if^box != nil^ and^!contact and^p.canHit(box, def) {
                for^hurtSlot, hurt in^def.hurts {
                    if^hurt != nil^ and^!contact and^hurt.vulnerable {
                        let^al, at, aw, ah = p.rect(box)
                        let^bl, bt, bw, bh = def.rect(hurt)
                        if^al < bl + bw and^bl < al + aw and^at < bt + bh and^bt < at + ah {
                            contact := true^
                            let^skill = p.skillNo
                            p.struck(box, def, hurt.rate, false^, hurt.flags) p.finishHitEvents()
                            hits += 1
                            print($"sweep-super {hits}: skill={skill} power={box.power} x={p.x:%.0f}/{def.x:%.0f} y={def.y:%.0f}")
                            if^skill = 236 and^box.power = 255 { finisher := true^ }
                            if^skill = 239 { startSuper := true^ }
                        }
                    }
                }
            }
        }
        p.pushAgainst(def)
    }
    if^hits != 11 or^!finisher { panic^$"Sweep -> super: hits={hits}, finisher={finisher}" }
    print("PASS: real box overlap / motion: sweep -> all ten super hits")
}

let^shake = p^{
    let^axis = vp.shake.Axis.new()
    axis.start(3, 6, 3)
    if^axis.offset != 6 { panic^"Fixed shake did not start" }
    axis.step()
    if^axis.offset != -6 { panic^"Shake did not alternate" }
    axis.start(0, 0, 0)
    if^axis.offset != -6 { panic^"Unused axis interrupted shake" }
    axis.step()
    axis.step()
    if^axis.offset != 0 { panic^"Shake did not expire" }
    axis.start(1, 8, 3)
    if^axis.offset != 8 { panic^"Fade-out shake start" }
    axis.step()
    if^axis.offset != -4 { panic^"Fade-out shake envelope" }
    axis.start(2, 8, 3)
    if^axis.offset != 0 { panic^"Fade-in shake start" }
    axis.step()
    if^axis.offset != -4 { panic^"Fade-in shake envelope" }
    axis.start(4, 8, 20)
    for^i from^0 to^19 {
        if^axis.offset.abs() > 8 { panic^"Random shake exceeded amplitude" }
        axis.step()
    }
    axis.start(1, 5, 1)
    if^axis.offset != 5 { panic^"One-frame shake was invisible" }
    axis.step()
    if^axis.offset != 0 { panic^"One-frame shake did not expire" }
    let^source = Fighter.new("assets/characters/カテジナ", 0, 0)
    source.screen(0, 0, 0, 0, 0, 0, "", 3, 4, 2, 3, 7, 4)
    if^vp.shake.horizontal.offset != 4 or^vp.shake.vertical.offset != 7 { panic^"EB axes were mixed" }
    for^i from^0 to^1 { vp.shake.horizontal.step() vp.shake.vertical.step() }
    if^vp.shake.horizontal.offset != 0 or^vp.shake.vertical.offset != 7 { panic^"Axis durations are not independent" }
    let^sc = vp.script.load("assets/characters/カテジナ/script.lton")
    if^sc is^nil^ { panic^"Missing shake script" }
    # Invoke an actual restored EB through Script.run, not directly through Axis.
    var^tested = false^
    for^n:number^, sk:vp.scriptdata.Skill in^sc.byId {
        for^at, b in^sk.blocks {
            if^b.op = "EB" and^(b.n[6] ?? 0) > 0 and^(b.n[8] ?? 0) > 0 and^!tested {
                vp.shake.horizontal.reset()
                let^p = Fighter.new("assets/characters/カテジナ", 123, 456)
                sc.install(p)
                p.start(n, at)
                p.advance()
                if^vp.shake.horizontal.mode = 0 { panic^"EB shake operands did not execute" }
                if^p.x != 123 or^p.y != 456 { panic^"Shake moved world coordinates" }
                tested := true^
            }
        }
    }
    if^!tested { panic^"No restored EB available" }
    print("PASS: shake envelopes, duration, independent axes, original EB execution")
}

let^comboColour = p^{
    let^dir = "assets/system/ヴァンガードプリンセス"
    let^sc = vp.script.load("assets/characters/ゆい/script.lton")
    let^sys = vp.script.load($"{dir}/script.lton")
    if^sc is^nil^ or^sys is^nil^ { panic^"Missing combo scripts" }
    let^p = Fighter.new("assets/characters/ゆい", 600, 500)
    sc.install(p)
    let^flow = vp.round.Round.new()
    flow.dir := dir
    flow.script := sys
    p.setv(128, 0)
    flow.showCombo(2, 600, 500, p.v(128))
    # The real falling reaction opens recovery and sets the red marker.
    p.start(163, 0)
    p.advance()
    if^p.v(128) != 1 { panic^"Recovery reaction did not set combo marker" }
    flow.showCombo(2, 600, 500, p.v(128))
    # The next tumble reaction clears it before either display's delayed V.
    p.begin(94)
    p.advance()
    if^p.v(128) != 0 { panic^"Tumble reaction did not clear combo marker" }
    for^i from^0 to^11 {
        for^c in^flow.combos { c.step() }
    }
    let^expected = {261, 12, 30, 29}
    for^i, c in^flow.combos {
        if^c.image != expected[i] { panic^$"Combo colour {i}: image={c.image}" }
    }
    if^p.v(128) != 0 { panic^"Combo display changed the shared marker" }
    # A later unrelated red state must not recolour an existing blue count.
    p.setv(128, 1)
    if^flow.combos[0]?.v(128) != 0 { panic^"Blue combo lost its hit-time marker" }
    p.setv(128, 0)
    print("PASS: original recovery/tumble scripts; simultaneous blue/red combo text and digits")
}

let^cornerRecoil = p^{
    let^dir = "assets/characters/ゆい"
    # No push boxes: this must work independently of FD body overlap.
    for^side in^{-1, 1} {
        for^kind from^0 to^7 {
            let^a = Fighter.new(dir, 320, 920)
            let^d = Fighter.new(dir, if^side > 0: 588 el^: 52;, 920)
            a.enemy := d d.enemy := a
            for^f in^{a, d} { f.minX := 50 f.maxX := 590 f.minXAir := 50 f.maxXAir := 590 }
            d.receiving := true^
            d.vx := side * 6
            if^kind = 1 { d.receiving := false^ d.blocking := true^ }
            if^kind = 2 { d.y := 820 }
            if^kind = 3 { d.life := 0 }
            if^kind = 4 { d.receiving := false^ }
            if^kind = 5 { a.receiving := true^ }
            if^kind = 6 { d.owner := a }
            if^kind = 7 { d.x := 320 }
            let^expected = if^kind <= 2: -side * 4 el^: 0;
            d.step()
            if^a.x != 320 or^a.cornerPush != expected { panic^$"Corner queue: {side}/{kind}" }
            # Pending recoil is consumed once even during hitstop, without
            # overwriting attack motion or starting an extra reaction.
            a.stop := 2
            a.vx := 3
            a.step() a.step()
            if^a.x != 320 + expected or^a.vx != 3 or^a.cornerPush != 0 { panic^$"Corner consume: {side}/{kind}" }
        }
    }
    # Real M/SG reaction, both player orders and both walls. The lost victim
    # travel must exactly equal the opponent's retreat over the same reaction.
    let^sc = vp.script.load($"{dir}/script.lton")
    if^sc is^nil^ { panic^"Missing corner reaction script" }
    for^side in^{-1, 1} {
        for^order from^0 to^1 {
            let^a = Fighter.new(dir, 640, 920)
            let^d = Fighter.new(dir, if^side > 0: 1230 el^: 50;, 920)
            let^free = Fighter.new(dir, 640, 920)
            a.enemy := d d.enemy := a
            d.minX := 50 d.maxX := 1230
            for^f in^{d, free} {
                sc.install(f)
                f.facing := -side
                f.beginReaction(47)
                f.receiving := true^
            }
            for^frame from^0 to^20 {
                if^order = 0 { a.step() d.step() else^: d.step() a.step() }
                free.step()
            }
            # Drain the final pending displacement without moving the victim.
            a.step()
            let^travel = free.x - 640
            if^travel * side <= 0 or^(a.x - 640 + travel).abs() > 0.00001 { panic^$"Real wall recoil: {side}/{order}" }
        }
    }
    print("PASS: corner recoil: hit/guard/air, excess only, KO/trade/object exclusions, real Yui reaction both sides/orders")
    for^reaction in^{56, 59, 185} {
        for^side in^{-1, 1} {
            var^distances : t^{number^[]} = {}
            var^durations : t^{number^[]} = {}
            for^enabled in^{false^, true^} {
                let^a = Fighter.new(dir, 640, 920)
                let^d = Fighter.new(dir, if^side > 0: 1230 el^: 50;, 920)
                a.enemy := d d.enemy := a
                d.minX := 50 d.maxX := 1230
                sc.install(d)
                d.facing := -side
                d.beginReaction(reaction)
                d.receiving := reaction != 185
                d.blocking := reaction = 185
                var^moving = 0
                var^switched = false^
                for^frame from^0 to^65 {
                    if^!enabled { d.off("wallHitting") }
                    d.step()
                    if^d.skillNo != reaction { switched := true^ }
                    if^a.cornerPush != 0 { moving += 1 }
                    a.step()
                }
                if^enabled and^!switched { panic^"Wall DS never ran" }
                distances.push^((a.x - 640).abs())
                durations.push^(moving)
            }
            print($"Wall DS #{reaction} side={side}: {durations[0]}f/{distances[0]}px -> {durations[1]}f/{distances[1]}px")
            if^durations[1] != 1 or^(distances[1] ?? 0) >= (distances[0] ?? 0) { panic^"Wall reaction kept its old ground motion" }
        }
    }
}

let^yuiForwardB = p^{
    let^sc = vp.script.load("assets/characters/ゆい/script.lton")
    let^ds = vp.script.load("assets/characters/えり/script.lton")
    if^sc is^nil^ or^ds is^nil^ { panic^"Missing Yui/Eri data" }
    for^side in^{-1, 1} {
        let^a = Fighter.new("assets/characters/ゆい", if^side > 0: 1170 el^: 110;, 920)
        let^d = Fighter.new("assets/characters/えり", if^side > 0: 1230 el^: 50;, 920)
        sc.install(a) ds.install(d)
        a.enemy := d d.enemy := a
        a.facing := side d.facing := -side
        a.begin(240) d.begin(1)
        var^cam = if^side > 0: 640 el^: 0;
        var^aim = cam
        var^hits = 0
        var^returnedFrames = 0
        var^returnedDistance = 0
        var^wallReaction = false^
        for^frame from^0 to^250 {
            for^f in^{a, d} {
                f.minX := std.math.max(50, cam + 50)
                f.maxX := std.math.min(1230, cam + 590)
                f.minXAir := f.minX f.maxXAir := f.maxX
            }
            a.step() d.step()
            if^a.cornerPush != 0 { returnedFrames += 1 returnedDistance += a.cornerPush.abs() }
            if^d.skillNo = 160 { wallReaction := true^ }
            a.stepObjects() d.stepObjects()
            if^a.finished() { a.begin(1) }
            if^d.finished() { d.begin(1) }
            for^slot, box in^a.hits {
                if^box != nil^ and^a.canHit(box, d) {
                    for^hurtSlot, hurt in^d.hurts {
                        if^hurt != nil^ and^hurt.vulnerable and^a.canHit(box, d) {
                            let^al, at, aw, ah = a.rect(box)
                            let^bl, bt, bw, bh = d.rect(hurt)
                            if^al < bl + bw and^bl < al + aw and^at < bt + bh and^bt < at + ah {
                                a.struck(box, d, hurt.rate, false^, hurt.flags) a.finishHitEvents()
                                hits += 1
                                if^d.jumpSkill != 155 or^!d.eventPending { panic^"6B queued the wrong reaction" }
                            }
                        }
                    }
                }
            }
            a.pushAgainst(d)
            let^delta = (aim - cam) / 2
            cam := (cam + if^delta < 0: delta.ceil() el^: delta.floor();).clamp(0, 640)
            aim := (a.x + d.x) / 2 - 320
        }
        print($"Yui 6B -> Eri side={side}: hits={hits}, wall={wallReaction}, recoil={returnedFrames}f/{returnedDistance}px, x={a.x}/{d.x}")
        if^hits != 1 or^!wallReaction or^returnedFrames > 30 { panic^"6B wall knockback did not stop" }
    }
}

let^reactionFacing = p^{
    for^side in^{1,-1} {
        for^location in^{100,300,500} {
            for^blocking in^{false^,true^} {
                let^owner = Fighter.new("",300-side*200,0)
                owner.facing := side
                let^a = Fighter.new("",location,0)
                a.owner := owner a.facing := side
                a.onHit[0] := 1 a.onGuard[0] := 2
                let^d = Fighter.new("",300,0)
                d.facing := -side d.enemy := owner
                d.skills[9001] := p^f:Fighter, at:number^{ f.move(-600,0) yield^ }
                d.reactHit[1] := 9001 d.reactHit[2] := 9001
                d.updateGuard(blocking,false^,true^)
                let^box = vp.fighter.Box.new(0,0,10,10)
                let^guarded,spark = a.struck(box,d,100,false^,"")
                if^guarded != blocking or^d.facing != -side { panic^"Projectile position reversed hit/guard facing" }
                d.stepScript()
                if^d.vx * side <= 0 { panic^"Reaction moved toward projectile owner" }
                # An explicitly reversed projectile follows its own facing, not its owner.
                a.facing := -side
                a.struck(box,d,100,false^,"")
                if^d.facing != side { panic^"Reaction ignored attacking actor facing" }
            }
        }
    }
    print("PASS: projectile hit/guard facing and recoil, both sides, front/back/same pivot, reversed actor")
}

public^let^update = p^dt:number^{
    vp.resource.pump(0.006)
    if^!done and^loadout.ready() {
        done := true^
        attack("assets/characters/カテジナ", "足払い", 1, 120)
        # 100 + (31 - floor(31 * 8 / 100)), before FD/low-life multipliers.
        attack("assets/characters/カテジナ", "けつ昇竜", 2, 129)
        guard()
        reactionFacing()
        melt()
        yuiSuper()
        landingAndPush()
        sweepSuper()
        shake()
        comboColour()
        cornerRecoil()
        yuiForwardB()
        print("PASS: combat regressions")
        love.event.quit()
    }
    if^love.timer.getTime() - began > 120 { panic^"Combat test timeout" }
}
public^let^draw = p^{}
public^let^quit = p^-> bool^{ vp.resource.stop() return^false^ }
